    <script>
        (function() {
            // ========== ЧАСТИЦЫ ==========
            const particlesContainer = document.getElementById('particles-container');
            const particleCount = 35;

            function createParticle() {
                const particle = document.createElement('div');
                particle.classList.add('particle');
                const size = Math.random() * 2.5 + 1;
                particle.style.width = size + 'px';
                particle.style.height = size + 'px';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.bottom = '-10px';
                const duration = Math.random() * 12 + 8;
                particle.style.animationDuration = duration + 's';
                particle.style.animationDelay = Math.random() * 10 + 's';
                const opacity = Math.random() * 0.5 + 0.2;
                particle.style.opacity = opacity;
                particlesContainer.appendChild(particle);

                // Удаление после анимации
                setTimeout(() => {
                    if (particle.parentNode) {
                        particle.remove();
                    }
                }, (duration + 10) * 1000);
            }

            for (let i = 0; i < particleCount; i++) {
                setTimeout(createParticle, Math.random() * 5000);
            }
            setInterval(() => {
                if (particlesContainer.children.length < particleCount + 10) {
                    createParticle();
                }
            }, 3000);

            // ========== ЧАСЫ В СТАТУС-БАРЕ ==========
            function updateClock() {
                const clockEl = document.getElementById('statusClock');
                if (clockEl) {
                    const now = new Date();
                    const hours = String(now.getHours()).padStart(2, '0');
                    const minutes = String(now.getMinutes()).padStart(2, '0');
                    const seconds = String(now.getSeconds()).padStart(2, '0');
                    clockEl.textContent = `13.06.1955 ${hours}:${minutes}:${seconds}`;
                }
            }
            updateClock();
            setInterval(updateClock, 1000);

            // ========== УЛУЧШЕННАЯ ЗАГРУЗКА ==========
            const bootEl = document.getElementById('boot');
            const terminalEl = document.getElementById('terminal');
            const progressBar = document.getElementById('bootProgressBar');
            const bootMem = document.getElementById('bootMem');
            const bootCpu = document.getElementById('bootCpu');
            const bootMod = document.getElementById('bootMod');

            let bootProgress = 0;
            const bootInterval = setInterval(() => {
                bootProgress += Math.random() * 8 + 2;
                if (bootProgress >= 100) {
                    bootProgress = 100;
                    clearInterval(bootInterval);
                    progressBar.style.width = '100%';
                    bootMem.textContent = '65536';
                    bootCpu.textContent = '100';
                    bootMod.textContent = '24';
                    setTimeout(() => {
                        bootEl.classList.add('hidden');
                        terminalEl.style.display = 'block';
                        // Запуск печати после показа терминала
                        setTimeout(initTypeEffect, 300);
                    }, 500);
                } else {
                    progressBar.style.width = bootProgress + '%';
                    bootMem.textContent = Math.floor(bootProgress * 655);
                    bootCpu.textContent = Math.floor(bootProgress * 0.85 + Math.random() * 10);
                    bootMod.textContent = Math.floor(bootProgress * 0.24);
                }
            }, 120);

            // ========== ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК ==========
            let activeTabId = "gameplay";
            let filesAnimationActive = false;
            let filesAnimationTimer = null;
            const tabButtons = document.querySelectorAll('.menu button');

            function openTab(id) {
                if (activeTabId === "files" && filesAnimationActive) {
                    cancelFilesAnimation();
                }
                document.querySelectorAll(".block").forEach(el => el.classList.remove("active"));
                const target = document.getElementById(id);
                if (target) {
                    target.classList.add("active");
                    // Прокрутка наверх
                    target.scrollTop = 0;
                }
                activeTabId = id;

                // Обновление активной кнопки
                tabButtons.forEach(btn => {
                    btn.classList.remove('tab-active');
                    if (btn.getAttribute('data-tab') === id) {
                        btn.classList.add('tab-active');
                    }
                });

                if (id === "files") {
                    startFilesAnimation();
                }

                // Лёгкий глитч-эффект при переключении
                const terminal = document.getElementById('terminal');
                terminal.classList.add('glitch-effect');
                setTimeout(() => terminal.classList.remove('glitch-effect'), 250);
            }

            // Обработчики на кнопки меню
            tabButtons.forEach(btn => {
                btn.addEventListener('click', function() {
                    const tabId = this.getAttribute('data-tab');
                    if (tabId) openTab(tabId);
                });
            });

            // ========== КЛАВИАТУРНЫЕ СОКРАЩЕНИЯ ==========
            const tabKeys = {
                '1': 'gameplay',
                '2': 'world',
                '3': 'combat',
                '4': 'dlc',
                '5': 'dev',
                '6': 'files',
                '7': 'lore'
            };

            document.addEventListener('keydown', function(e) {
                const key = e.key.toLowerCase();
                if (tabKeys[key]) {
                    e.preventDefault();
                    openTab(tabKeys[key]);
                }
                if (key === 'm') {
                    e.preventDefault();
                    toggleMusic();
                }
                if (key === 'g') {
                    e.preventDefault();
                    triggerGlitch();
                }
                // Escape для сброса анимации файлов
                if (key === 'escape' && activeTabId === 'files' && filesAnimationActive) {
                    e.preventDefault();
                    cancelFilesAnimation();
                    startFilesAnimation();
                }
            });

            // ========== СЛУЧАЙНЫЙ ГЛИТЧ ==========
            function triggerGlitch() {
                const terminal = document.getElementById('terminal');
                terminal.classList.add('glitch-effect');
                // Меняем цвет border на короткое время
                terminal.style.borderColor = 'rgba(255,50,50,0.7)';
                terminal.style.boxShadow = '0 0 60px rgba(255,50,50,0.3), 0 0 100px rgba(255,0,0,0.2)';
                setTimeout(() => {
                    terminal.classList.remove('glitch-effect');
                    terminal.style.borderColor = 'rgba(0,255,159,0.25)';
                    terminal.style.boxShadow = '';
                }, 250);
            }
            // Автоматический редкий глитч
            setInterval(() => {
                if (Math.random() < 0.15) {
                    triggerGlitch();
                }
            }, 15000);

            // ========== АНИМАЦИЯ СЕКРЕТНЫХ ФАЙЛОВ ==========
            const initialLines = [
                "ДОСТУП К СЕКРЕТНЫМ ДАННЫМ...",
                "ПРОЕКТ: КОЛЛЕКТИВ",
                "СТАТУС: ОШИБКА",
                "РОБОТЫ: ВНЕ КОНТРОЛЯ",
                "ПРИЧИНА: НЕИЗВЕСТНО"
            ];
            const headerLine = "ДОПОЛНИТЕЛЬНЫЕ ФАЙЛЫ РАСШИФРОВАНЫ:";
            const detailedFiles = [
                "«Дневник Петрова»: \"Сеченов планирует установить чипы всем гражданам. Мы не можем этого допустить.\"",
                "«Протокол 734-А»: \"Испытания полимера на людях привели к необратимым изменениям психики. Объекты классифицированы как 'Абстракции'.\"",
                "«Запись переговора O5»: \"Если 'Атомное сердце' будет активировано, человечество потеряет свободу воли.\"",
                "«Схема Близняшек»: \"Созданы из биомассы погибших сотрудников. Эмоциональный интеллект — 98%. Подавлен.\"",
                "«Последнее сообщение ГРУ»: \"Предприятие 3826 зачищено. Рекомендуем ядерную бомбардировку.\"",
                "«Лог испытаний полимера #77»: \"Субъект демонстрирует неконтролируемую регенерацию. Рекомендовано уничтожение.\"",
                "«Аудиосообщение от ХРАЗ»: \"П-3, не верь Сеченову. Он использует тебя. Ищи правду в старых лабораториях.\"",
                "«Схема нейрополимера»: \"При введении вызывает полное подчинение воле оператора. Проект 'Коллектив 2.0' — марионетки.\"",
                "«Приказ № 3826/К»: \"Всем сотрудникам покинуть зону. Активирован протокол 'Чистка'. Уничтожить всё живое.\"",
                "«Запись с камер наблюдения»: \"Объект 'Чёрный сталкер' передвигается по вентиляции. Скорость 80 км/ч. Оружие неэффективно.\""
            ];

            let currentStep = 0;
            let lineTimeout = null;
            let filesContainer = null;

            function cancelFilesAnimation() {
                if (lineTimeout) {
                    clearTimeout(lineTimeout);
                    lineTimeout = null;
                }
                filesAnimationActive = false;
                currentStep = 0;
            }

            function startFilesAnimation() {
                if (filesAnimationActive) return;
                filesAnimationActive = true;
                currentStep = 0;
                const filesBlock = document.getElementById("files");
                if (!filesBlock) return;
                filesBlock.innerHTML = "";
                const displayDiv = document.createElement("div");
                displayDiv.id = "tempLine";
                displayDiv.style.minHeight = "24px";
                filesBlock.appendChild(displayDiv);
                const permanentContainer = document.createElement("div");
                permanentContainer.id = "permanentFiles";
                filesBlock.appendChild(permanentContainer);

                function nextStep() {
                    if (!filesAnimationActive) return;
                    if (currentStep < initialLines.length) {
                        const line = initialLines[currentStep];
                        displayDiv.innerHTML = `> ${line}`;
                        displayDiv.classList.add("blinking-dots");
                        currentStep++;
                        lineTimeout = setTimeout(() => {
                            displayDiv.innerHTML = "";
                            displayDiv.classList.remove("blinking-dots");
                            nextStep();
                        }, 5000);
                        return;
                    }
                    if (currentStep === initialLines.length) {
                        displayDiv.innerHTML = `> ${headerLine}`;
                        displayDiv.classList.remove("blinking-dots");
                        currentStep++;
                        lineTimeout = setTimeout(() => {
                            displayDiv.innerHTML = "";
                            nextStep();
                        }, 5000);
                        return;
                    }
                    const detailedIndex = currentStep - (initialLines.length + 1);
                    if (detailedIndex < detailedFiles.length) {
                        const fileLine = detailedFiles[detailedIndex];
                        const newP = document.createElement("p");
                        newP.innerHTML = `> ${fileLine}`;
                        newP.classList.add("line-appear");
                        permanentContainer.appendChild(newP);
                        // Автопрокрутка
                        const filesBlockEl = document.getElementById("files");
                        if (filesBlockEl) {
                            filesBlockEl.scrollTop = filesBlockEl.scrollHeight;
                        }
                        currentStep++;
                        lineTimeout = setTimeout(() => {
                            nextStep();
                        }, 5000);
                        return;
                    }
                    filesAnimationActive = false;
                    lineTimeout = null;
                }
                nextStep();
            }

            // ========== МУЗЫКА ==========
            const audio = document.getElementById('bgMusic');
            const toggleBtn = document.getElementById('musicToggle');
            const statusSpan = document.getElementById('musicStatus');
            audio.volume = 0.5;
            let isPlaying = false;

            function toggleMusic() {
                if (isPlaying) {
                    audio.pause();
                    statusSpan.innerText = "ВКЛЮЧИТЬ МУЗЫКУ";
                    toggleBtn.classList.remove('playing');
                } else {
                    audio.play().catch(e => console.log("Автовоспроизведение заблокировано браузером"));
                    statusSpan.innerText = "ВЫКЛЮЧИТЬ МУЗЫКУ";
                    toggleBtn.classList.add('playing');
                }
                isPlaying = !isPlaying;
            }

            toggleBtn.addEventListener('click', toggleMusic);

            // ========== ЭФФЕКТ ПЕЧАТИ ДЛЯ ПЕРВОГО АБЗАЦА ==========
            function initTypeEffect() {
                const textElement = document.querySelector("#gameplay p");
                if (textElement && !textElement.dataset.typed) {
                    textElement.dataset.typed = 'true';
                    const original = textElement.innerText;
                    textElement.innerText = "";
                    let i = 0;

                    function type() {
                        if (i < original.length) {
                            textElement.innerText += original.charAt(i);
                            i++;
                            // Случайная вариация скорости для реализма
                            const delay = Math.random() * 15 + 12;
                            setTimeout(type, delay);
                        }
                    }
                    type();
                }
            }

            // ===== СКРЫТИЕ ПОДСКАЗКИ КЛАВИШ =====
            setTimeout(() => {
                const keyHint = document.getElementById('keyHint');
                if (keyHint) {
                    keyHint.style.opacity = '0';
                    setTimeout(() => { keyHint.style.display = 'none'; }, 2000);
                }
            }, 25000);

            // ===== ОБРАБОТКА КЛИКОВ ВНЕ ТЕРМИНАЛА ДЛЯ ГЛИТЧА =====
            document.addEventListener('click', function(e) {
                if (e.target === document.body || e.target.classList.contains('scanlines-overlay') || e
                    .target.classList.contains('vignette-overlay')) {
                    // Редкий глитч при клике на фон
                    if (Math.random() < 0.3 && terminalEl.style.display === 'block') {
                        const miniGlitch = document.createElement('div');
                        miniGlitch.style.cssText = `
                            position: fixed;
                            pointer-events: none;
                            z-index: 998;
                            top: ${e.clientY - 20}px;
                            left: ${e.clientX - 40}px;
                            width: 80px;
                            height: 4px;
                            background: rgba(0,255,159,0.6);
                            box-shadow: 0 0 20px rgba(0,255,159,0.8);
                            animation: glitchLine 0.4s ease-out forwards;
                        `;
                        document.body.appendChild(miniGlitch);
                        setTimeout(() => miniGlitch.remove(), 400);
                    }
                }
            });

            // Стиль для miniGlitch
            const glitchStyle = document.createElement('style');
            glitchStyle.textContent = `
                @keyframes glitchLine {
                    0% { opacity: 1; transform: scaleX(1); }
                    100% { opacity: 0; transform: scaleX(3); }
                }
            `;
            document.head.appendChild(glitchStyle);

            console.log('%c⚙ COMPLEX 3826 TERMINAL %cАКТИВЕН %c🚀',
                'color: #ff1a1a; font-size: 20px; text-shadow: 0 0 10px red;',
                'color: #00ff9f;',
                'color: #ffb000;');
            console.log('%cВсе системы работают в штатном режиме. Добро пожаловать, товарищ.',
                'color: #00ff9f; font-style: italic;');
            console.log('%cНажмите 1-7 для навигации, M для музыки, G для глитча.',
                'color: rgba(0,255,159,0.6); font-size: 11px;');

        })();
    </script>
</body>
</html>
