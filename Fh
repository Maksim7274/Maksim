<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fazbear's Hunt · Not Official Server</title>
  <meta name="description" content="Fazbear's Hunt — сервер выживания и охоты с аниматрониками, уникальными картами и подарками.">
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    :root {
      --bg-body: #0b0a0c;
      --bg-card: rgba(18, 14, 17, 0.7);
      --border-primary: #6a3f4b;
      --border-secondary: #5e3d48;
      --accent: #b34b6b;
      --accent-light: #8f4b5a;
      --text-light: #f0eae3;
      --text-pink: #f7c9d6;
      --text-muted: #b18697;
      --shadow-glow: rgba(200, 70, 100, 0.3);
      --dark-bg-inner: #1c1118;
      --dark-bg-tag: #2f1d26;
      --radius-xl: 2.5rem;
      --radius-round: 60px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: var(--bg-body);
      font-family: 'Segoe UI', 'Arial', system-ui, sans-serif;
      color: var(--text-light);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2rem 1rem;
      background-image: radial-gradient(circle at 20% 30%, #1f141a 0%, var(--bg-body) 80%);
    }

    .server-card {
      max-width: 1400px;
      width: 100%;
      background: var(--bg-card);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--border-primary);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8), 0 0 30px var(--shadow-glow);
      border-radius: 3rem 3rem 2rem 2rem;
      padding: 2rem 2rem 3rem;
      transition: 0.3s;
    }

    .header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px dashed var(--accent-light);
      padding-bottom: 1.5rem;
      margin-bottom: 2.5rem;
    }

    .server-title h1 {
      font-size: 2.8rem;
      font-weight: 800;
      letter-spacing: 2px;
      background: linear-gradient(135deg, var(--text-pink), #e07b9e);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 20px var(--accent);
    }

    .server-title .sub {
      font-size: 1.1rem;
      color: #bda3ae;
      background: rgba(50, 30, 40, 0.5);
      display: inline-block;
      padding: 0.3rem 1.2rem;
      border-radius: 40px;
      backdrop-filter: blur(4px);
      border: 1px solid #754b56;
      margin-top: 0.3rem;
    }

    .server-status {
      background: #1c1218;
      padding: 0.6rem 1.8rem;
      border-radius: var(--radius-round);
      border-left: 4px solid #f57c9b;
      font-weight: 600;
      color: #f0c8d4;
      box-shadow: 0 0 20px #9f4b66;
    }

    .server-status i {
      color: #6fdf8b;
      margin-right: 8px;
    }

    .gif-block {
      background: #130d12;
      border-radius: 2rem;
      padding: 0.8rem 0.8rem 0.4rem;
      margin: 0.5rem 0 1.8rem;
      border: 1px solid #7a4b5b;
      display: flex;
      justify-content: center;
      align-items: center;
      box-shadow: inset 0 0 30px rgba(150, 50, 80, 0.3);
    }

    .gif-block img {
      max-width: 100%;
      max-height: 140px;
      border-radius: 1.2rem;
      display: block;
      width: auto;
      height: auto;
      object-fit: contain;
    }

    .double-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin: 2rem 0;
    }

    @media (max-width: 720px) {
      .double-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }

    .map-block,
    .animatronic-block {
      background: rgba(22, 16, 20, 0.6);
      backdrop-filter: blur(5px);
      border-radius: var(--radius-xl);
      padding: 1.5rem 1.5rem 2rem;
      border: 1px solid var(--border-secondary);
      box-shadow: inset 0 0 30px rgba(70, 30, 45, 0.5);
    }

    .block-title {
      font-size: 1.5rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 12px;
      border-bottom: 2px dotted #7d4e5c;
      padding-bottom: 0.8rem;
      margin-bottom: 1.8rem;
      color: #f3dae3;
    }

    .block-title i {
      color: #da8ca3;
      font-size: 1.8rem;
    }

    .map-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      justify-content: center;
    }

    .map-item {
      background: var(--dark-bg-inner);
      border-radius: 3rem;
      padding: 0.4rem 1.2rem 0.4rem 1rem;
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid #77505e;
      box-shadow: 0 4px 0 #2d1b22;
      transition: 0.2s;
      font-size: 0.85rem;
    }

    .map-item i {
      font-size: 1.2rem;
      color: #d989a4;
      width: 1.6rem;
      text-align: center;
    }

    .map-item span {
      font-weight: 500;
      color: #eddae2;
      word-break: break-word;
      max-width: 140px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .map-item small {
      color: var(--text-muted);
      font-size: 0.6rem;
      background: var(--dark-bg-tag);
      padding: 0.05rem 0.6rem;
      border-radius: 20px;
      margin-left: 2px;
    }

    .anim-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1.2rem;
    }

    .anim-card {
      background: var(--dark-bg-inner);
      border-radius: 1.8rem;
      padding: 0.8rem 0.8rem 1rem;
      text-align: center;
      border: 1px solid #563a42;
      box-shadow: 0 6px 0 #2b1b21, 0 8px 16px rgba(0,0,0,0.5);
      transition: all 0.2s ease;
    }

    .anim-card:hover {
      transform: translateY(-4px);
      border-color: #c0637e;
      box-shadow: 0 8px 0 #331f26, 0 12px 24px #1d0f14;
    }

    .anim-card .anim-photo {
      width: 100%;
      aspect-ratio: 1/1;
      border-radius: 1.2rem;
      background: #2a1b24;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      margin-bottom: 0.5rem;
      border: 2px solid var(--border-secondary);
    }

    .anim-card .anim-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .anim-card .anim-name {
      font-weight: 600;
      font-size: 0.95rem;
      color: #efd2dc;
      display: block;
      margin-top: 0.2rem;
    }

    .anim-card .anim-tag {
      font-size: 0.6rem;
      color: var(--text-muted);
      background: var(--dark-bg-tag);
      padding: 0.05rem 0.8rem;
      border-radius: 20px;
      display: inline-block;
      margin-top: 0.2rem;
    }

    .gifts-block {
      margin: 2.5rem 0 1.5rem;
    }

    .gifts-block .gifts-header {
      margin-bottom: 2.5rem;
    }

    .gifts-header {
      font-size: 1.5rem;
      font-weight: 500;
      color: #f3dae3;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .gifts-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.2rem;
      margin-top: 0.5rem;
    }

    .gift-badge {
      background: #1d121a;
      border-radius: var(--radius-round);
      padding: 0.4rem 1.4rem 0.4rem 1rem;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      border: 1px solid #7e4d5f;
      box-shadow: 0 6px 0 #281b21;
      transition: 0.15s;
      font-weight: 500;
      color: #f2dae2;
      font-size: 0.85rem;
    }

    .gift-badge i {
      color: #f09bb6;
      font-size: 1.4rem;
      min-width: 1.6rem;
      text-align: center;
    }

    .gift-badge:hover {
      transform: scale(1.03);
      border-color: #c0728b;
    }

    .footer {
      margin-top: 3.5rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid #4f353f;
      padding-top: 2rem;
      color: #b28b99;
      font-size: 0.9rem;
    }

    .footer i {
      color: #b1627a;
      margin: 0 4px;
    }

    .footer .copy {
      background: #21161d;
      padding: 0.2rem 1.5rem;
      border-radius: 40px;
      border: 1px solid #6b4553;
    }

    @media (max-width: 550px) {
      .server-title h1 {
        font-size: 2.2rem;
      }
      .server-status {
        margin-top: 0.8rem;
        width: 100%;
        text-align: center;
      }
      .anim-grid {
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      }
    }

    @media (max-width: 480px) {
      .map-item span {
        max-width: 90px;
      }
      .gift-badge {
        font-size: 0.75rem;
        padding: 0.3rem 1rem 0.3rem 0.8rem;
      }
      .gift-badge i {
        font-size: 1.1rem;
        min-width: 1.2rem;
      }
    }
  </style>
</head>
<body>
  <div class="server-card">
    <!-- HEADER -->
    <div class="header">
      <div class="server-title">
        <h1>Fazbear's Hunt</h1>
        <div class="sub"><i class="fas fa-paw" style="margin-right: 10px;"></i> Not Official Server</div>
      </div>
      <div class="server-status">
        <i class="fas fa-circle"></i> ONLINE · 24/7
      </div>
    </div>

    <!-- GIF -->
    <div class="gif-block">
      <img src="https://media.tenor.com/m6Bq5A0XBEYAAAAC/fnaf-fazbear-fright.gif" alt="Анимация Fazbear's Hunt" decoding="async">
    </div>

    <!-- описание -->
    <div style="background: #1d121b; padding: 1.2rem 2rem; border-radius: 60px; border-left: 6px solid #d46b8a; margin-bottom: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem;">
      <i class="fas fa-ghost" style="font-size: 2rem; color: #ca7f97;"></i>
      <span style="font-size: 1.05rem; letter-spacing: 0.4px;"><strong style="color: #f0b8cc;">Fazbear's Hunt</strong> — выживание / охота. Аниматроники оживают, карты полны секретов. Присоединяйся!</span>
      <span style="margin-left: auto; background: #351f2a; padding: 0.2rem 1.2rem; border-radius: 40px; border: 1px solid #965d74;"><i class="fas fa-users"></i> 12/32</span>
    </div>

    <!-- КАРТЫ + АНИМАТРОНИКИ -->
    <div class="double-grid">
      <!-- Карты -->
      <div class="map-block">
        <div class="block-title">
          <i class="fas fa-map"></i> Карты (21)
        </div>
        <div class="map-list">
          <div class="map-item"><i class="fas fa-chess-queen"></i> <span>sc_vector</span> <small>v</small></div>
          <div class="map-item"><i class="fas fa-copy"></i> <span>fh_copybeach_r1</span> <small>c</small></div>
          <div class="map-item"><i class="fas fa-school"></i> <span>sc_baldi_education_v1</span> <small>b</small></div>
          <div class="map-item"><i class="fas fa-snowflake"></i> <span>gm_2house_winter</span> <small>w</small></div>
          <div class="map-item"><i class="fas fa-moon"></i> <span>fh_2house_night</span> <small>n</small></div>
          <div class="map-item"><i class="fas fa-pizza-slice"></i> <span>sc_freddys</span> <small>f</small></div>
          <div class="map-item"><i class="fas fa-utensils"></i> <span>fh_cantina</span> <small>c</small></div>
          <div class="map-item"><i class="fas fa-parking"></i> <span>fh_mallparking</span> <small>m</small></div>
          <div class="map-item"><i class="fas fa-tunnel"></i> <span>gm_construct_tunnels_v2_fhno</span> <small>t</small></div>
          <div class="map-item"><i class="fas fa-industry"></i> <span>fh_turbine</span> <small>t</small></div>
          <div class="map-item"><i class="fas fa-ghost"></i> <span>fh_forgotten</span> <small>f</small></div>
          <div class="map-item"><i class="fas fa-swimmer"></i> <span>fh_mpd_pool</span> <small>p</small></div>
          <div class="map-item"><i class="fas fa-store"></i> <span>ann_mall_fhno</span> <small>a</small></div>
          <div class="map-item"><i class="fas fa-university"></i> <span>gm_canterlothigh_night_smc</span> <small>c</small></div>
          <div class="map-item"><i class="fas fa-dumbbell"></i> <span>sc_trainingcenter</span> <small>t</small></div>
          <div class="map-item"><i class="fas fa-tv"></i> <span>gm_hhgregg_fhno</span> <small>h</small></div>
          <div class="map-item"><i class="fas fa-mountain"></i> <span>slash_lodge</span> <small>s</small></div>
          <div class="map-item"><i class="fas fa-graduation-cap"></i> <span>sc_highschool</span> <small>h</small></div>
          <div class="map-item"><i class="fas fa-tree"></i> <span>sc_redforest</span> <small>r</small></div>
          <div class="map-item"><i class="fas fa-chalkboard"></i> <span>fh_school</span> <small>s</small></div>
          <div class="map-item"><i class="fas fa-shopping-bag"></i> <span>gm_everpine_mall</span> <small>e</small></div>
        </div>
      </div>

      <!-- Аниматроники с фото -->
      <div class="animatronic-block">
        <div class="block-title">
          <i class="fas fa-robot"></i> Аниматроники
        </div>
        <div class="anim-grid">
          <div class="anim-card">
            <div class="anim-photo">
              <img src="data:image/webp;base64," alt="Nightmare Fredbear" decoding="async">
            </div>
            <span class="anim-name">Nightmare Fredbear</span>
            <span class="anim-tag">nightmare</span>
          </div>
          <div class="anim-card">
            <div class="anim-photo">
              <img src="data:image/webp;base64," alt="Nightmare" decoding="async">
            </div>
            <span class="anim-name">Nightmare</span>
            <span class="anim-tag">shadow</span>
          </div>
          <div class="anim-card">
            <div class="anim-photo">
              <img src="data:image/webp;base64," alt="Nightmarionne" decoding="async">
            </div>
            <span class="anim-name">Nightmarionne</span>
            <span class="anim-tag">puppet</span>
          </div>
          <div class="anim-card">
            <div class="anim-photo">
              <img src="data:image/webp;base64," alt="The Prototype" decoding="async">
            </div>
            <span class="anim-name">The Prototype</span>
            <span class="anim-tag">prototype</span>
          </div>
          <div class="anim-card">
            <div class="anim-photo">
              <img src="data:image/webp;base64," alt="Ennard" decoding="async">
            </div>
            <span class="anim-name">Ennard</span>
            <span class="anim-tag">quiet</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ПОДАРКИ -->
    <div class="gifts-block">
      <h2 class="gifts-header"><i class="fas fa-gift" style="margin-right: 12px;"></i> Подарки</h2>
      <div class="gifts-grid">
        <div class="gift-badge"><i class="fas fa-khanda"></i> Керамбит</div>
        <div class="gift-badge"><i class="fas fa-tree"></i> Керамбит «Бореал»</div>
        <div class="gift-badge"><i class="fas fa-water"></i> Керамбит «Синяя сталь»</div>
        <div class="gift-badge"><i class="fas fa-spider"></i> Керамбит «Багровые нити»</div>
        <div class="gift-badge"><i class="fas fa-ruler"></i> Линейка Балди</div>
        <div class="gift-badge"><i class="fas fa-seal"></i> Тюлень</div>
        <div class="gift-badge"><i class="fas fa-dog"></i> Лай</div>
        <div class="gift-badge"><i class="fas fa-smoking"></i> Сигареты</div>
        <div class="gift-badge"><i class="fas fa-smoking"></i> Сигареты «Блат»</div>
        <div class="gift-badge"><i class="fas fa-smoking"></i> Сигареты «Дешёвые»</div>
        <div class="gift-badge"><i class="fas fa-mail-bulk"></i> Петиция</div>
        <div class="gift-badge"><i class="fas fa-shovel"></i> Лопата</div>
        <div class="gift-badge"><i class="fas fa-beer"></i> Пиво</div>
        <div class="gift-badge"><i class="fas fa-plane"></i> План побега</div>
      </div>
    </div>

    <!-- статистика -->
    <div style="margin: 2.2rem 0 0.5rem; border-radius: 2rem; background: #1d141c; padding: 1.5rem 1.5rem 0.8rem; border: 1px solid #62434f;">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-around; gap: 20px; align-items: center;">
        <div style="display: flex; align-items: center; gap: 14px; background: #271d24; padding: 0.3rem 1.8rem 0.3rem 1rem; border-radius: 60px;">
          <i class="fas fa-image" style="color: #d987a4; font-size: 1.8rem;"></i>
          <span style="font-weight: 300;">Карты: <strong style="color: #f3c8d6;">21</strong> <span style="color: #b18293;">|</span> <i class="fas fa-map-pin"></i></span>
        </div>
        <div style="display: flex; align-items: center; gap: 14px; background: #271d24; padding: 0.3rem 1.8rem 0.3rem 1rem; border-radius: 60px;">
          <i class="fas fa-robot" style="color: #d987a4; font-size: 1.8rem;"></i>
          <span style="font-weight: 300;">Аниматроники: <strong style="color: #f3c8d6;">5</strong> <span style="color: #b18293;">|</span> <i class="fas fa-crown"></i></span>
        </div>
        <div style="display: flex; align-items: center; gap: 14px; background: #271d24; padding: 0.3rem 1.8rem 0.3rem 1rem; border-radius: 60px;">
          <i class="fas fa-gift" style="color: #d987a4; font-size: 1.8rem;"></i>
          <span style="font-weight: 300;">Подарки: <strong style="color: #f3c8d6;">14</strong> <span style="color: #b18293;">|</span> <i class="fas fa-star"></i></span>
        </div>
      </div>
      <div style="display: flex; justify-content: center; gap: 0.6rem; flex-wrap: wrap; margin: 1.2rem 0 0.2rem; color: #bb8d9d; font-size: 0.75rem;">
        <span><i class="fas fa-check-circle" style="color: #9f6d7e;"></i> Все карты из списка</span>
        <span>•</span>
        <span><i class="fas fa-check-circle" style="color: #9f6d7e;"></i> 5 аниматроников</span>
        <span>•</span>
        <span><i class="fas fa-check-circle" style="color: #9f6d7e;"></i> 14 подарков</span>
      </div>
    </div>

    <!-- footer -->
    <div class="footer">
      <div><i class="fas fa-shield-alt"></i>  Fazbear's Hunt <span style="color: #a26e81;">|</span> Not Official Server</div>
      <div class="copy"><i class="fas fa-tag"></i>  v.2.6 · <i class="fas fa-users"></i>  active</div>
      <div><i class="fas fa-steam"></i>  <i class="fas fa-discord"></i>  <i class="fas fa-gamepad"></i></div>
    </div>

    <div style="margin-top: 2rem; text-align: center; font-size: 0.75rem; color: #684b56; letter-spacing: 1px;">
      <i class="fas fa-moon"></i>  midnight shift ·  <i class="fas fa-crown"></i>  fazbear's hunt
    </div>
  </div>
</body>
</html>
