<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IndustrialCraft 2 | Энциклопедия мода</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0b0d14;
            color: #e8ecf4;
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Атмосферный фон с индустриальным градиентом */
        .industrial-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            background: radial-gradient(ellipse at 30% 40%, #1a1f2e, #07080e);
        }

        .industrial-bg::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.04"><path fill="none" stroke="%23f5a623" stroke-width="0.3" d="M10 10 L90 10 M10 20 L90 20 M10 30 L90 30 M10 40 L90 40 M10 50 L90 50 M10 60 L90 60 M10 70 L90 70 M10 80 L90 80 M10 90 L90 90 M20 10 L20 90 M30 10 L30 90 M40 10 L40 90 M50 10 L50 90 M60 10 L60 90 M70 10 L70 90 M80 10 L80 90 M90 10 L90 90"/><circle cx="50" cy="50" r="20" fill="none" stroke="%23f5a623" stroke-width="0.5"/></svg>');
            background-repeat: repeat;
            background-size: 60px;
            pointer-events: none;
        }

        /* Оранжевые акценты (фирменный цвет IC2) */
        .ic-orange {
            color: #f5a623;
        }

        .ic-glow {
            text-shadow: 0 0 12px #f5a623, 0 0 30px #f5a62355;
        }

        /* Навигация */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(11, 13, 20, 0.85);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid #f5a62333;
            z-index: 1000;
            padding: 12px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Orbitron', monospace;
            font-size: 1.4rem;
            font-weight: 700;
            color: #f5a623;
            letter-spacing: 2px;
        }
        .logo i {
            margin-right: 8px;
        }

        .nav-links {
            display: flex;
            gap: 28px;
            list-style: none;
            font-weight: 500;
        }
        .nav-links a {
            color: #bcc4d8;
            text-decoration: none;
            font-size: 0.9rem;
            transition: 0.2s;
            position: relative;
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background: #f5a623;
            transition: 0.3s;
        }
        .nav-links a:hover {
            color: #f5a623;
        }
        .nav-links a:hover::after {
            width: 100%;
        }

        .burger {
            display: none;
            flex-direction: column;
            gap: 5px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
        }
        .burger span {
            width: 26px;
            height: 2px;
            background: #e8ecf4;
            transition: 0.3s;
        }

        /* Герой */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 120px 5% 80px;
        }

        .hero h1 {
            font-family: 'Orbitron', monospace;
            font-size: 4.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #f5a623, #d4891a);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: 2px;
        }

        .hero .sub {
            font-size: 1.3rem;
            color: #9aa9c9;
            margin-top: 12px;
            max-width: 650px;
        }

        .hero .badge {
            margin-top: 28px;
            display: inline-block;
            background: #f5a62322;
            border: 1px solid #f5a62366;
            padding: 8px 28px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #f5a623;
            letter-spacing: 1px;
        }

        /* Секции */
        .section {
            padding: 80px 5%;
            max-width: 1300px;
            margin: 0 auto;
        }

        .section-title {
            font-family: 'Orbitron', monospace;
            font-size: 2.4rem;
            font-weight: 700;
            border-left: 5px solid #f5a623;
            padding-left: 20px;
            margin-bottom: 48px;
            color: #f0f4ff;
        }

        .section-title span {
            color: #f5a623;
        }

        /* Карточки */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 28px;
        }

        .card {
            background: rgba(20, 25, 40, 0.6);
            backdrop-filter: blur(8px);
            border-radius: 24px;
            padding: 28px 24px;
            border: 1px solid #2d3448;
            transition: all 0.3s ease;
            cursor: default;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #f5a623, #d4891a);
            transform: scaleX(0);
            transform-origin: left;
            transition: 0.4s;
        }

        .card:hover::before {
            transform: scaleX(1);
        }

        .card:hover {
            transform: translateY(-8px);
            border-color: #f5a62366;
            box-shadow: 0 12px 40px rgba(245, 166, 35, 0.12);
        }

        .card i {
            font-size: 2.6rem;
            color: #f5a623;
            margin-bottom: 16px;
            display: inline-block;
        }

        .card h3 {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: #f0f4ff;
        }

        .card p {
            color: #aab4d0;
            font-size: 0.95rem;
        }

        .card .tag {
            display: inline-block;
            margin-top: 14px;
            background: #1e2538;
            padding: 4px 16px;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: 600;
            color: #f5a623;
            border: 1px solid #f5a62344;
        }

        /* Секция дополнений */
        .addon-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
        }

        .addon-card {
            background: rgba(16, 20, 32, 0.5);
            backdrop-filter: blur(6px);
            border-radius: 20px;
            padding: 24px 20px;
            border: 1px solid #2a3048;
            transition: 0.25s;
            text-align: center;
        }

        .addon-card:hover {
            border-color: #f5a623;
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(245, 166, 35, 0.08);
        }

        .addon-card .icon {
            font-size: 2.8rem;
            color: #f5a623;
            margin-bottom: 12px;
        }

        .addon-card h4 {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .addon-card p {
            font-size: 0.85rem;
            color: #aab4d0;
        }

        .addon-card .version {
            display: inline-block;
            margin-top: 12px;
            font-size: 0.7rem;
            background: #1a2038;
            padding: 2px 14px;
            border-radius: 30px;
            color: #f5a623;
        }

        /* Интерактивный слайдер (JS) */
        .slider-section {
            background: rgba(16, 20, 32, 0.4);
            border-radius: 32px;
            padding: 48px 40px;
            border: 1px solid #2a3048;
            margin-top: 20px;
        }

        .slider-container {
            display: flex;
            gap: 30px;
            align-items: center;
            flex-wrap: wrap;
        }

        .slider-text {
            flex: 1;
            min-width: 200px;
        }
        .slider-text h3 {
            font-size: 1.6rem;
            margin-bottom: 8px;
            color: #f5a623;
        }
        .slider-text p {
            color: #b0bbd8;
        }

        .slider-control {
            flex: 1;
            min-width: 200px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .slider-control input[type="range"] {
            width: 100%;
            height: 6px;
            -webkit-appearance: none;
            appearance: none;
            background: #2a3048;
            border-radius: 10px;
            outline: none;
        }

        .slider-control input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            background: #f5a623;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 0 12px #f5a62388;
            transition: 0.2s;
        }

        .slider-control input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }

        .slider-value {
            font-family: 'Orbitron', monospace;
            font-size: 1.8rem;
            font-weight: 700;
            color: #f5a623;
            text-align: center;
        }

        /* Кнопка */
        .btn-ic {
            display: inline-block;
            background: #f5a623;
            color: #0b0d14;
            font-weight: 600;
            padding: 12px 36px;
            border-radius: 40px;
            border: none;
            cursor: pointer;
            transition: 0.25s;
            font-size: 1rem;
            text-decoration: none;
        }
        .btn-ic:hover {
            background: #d4891a;
            transform: scale(1.02);
            box-shadow: 0 8px 24px #f5a62344;
        }

        /* Footer */
        footer {
            border-top: 1px solid #1e2538;
            padding: 40px 5%;
            text-align: center;
            color: #7a86a8;
            font-size: 0.85rem;
            margin-top: 40px;
        }

        footer .social {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-bottom: 16px;
        }
        footer .social a {
            color: #7a86a8;
            font-size: 1.4rem;
            transition: 0.2s;
        }
        footer .social a:hover {
            color: #f5a623;
            transform: translateY(-2px);
        }

        /* Анимация появления */
        .fade-up {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        .fade-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Адаптив */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
                flex-direction: column;
                gap: 12px;
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                background: rgba(11, 13, 20, 0.96);
                padding: 24px 5%;
                border-bottom: 1px solid #f5a62333;
            }
            .nav-links.open {
                display: flex;
            }
            .burger {
                display: flex;
            }
            .hero h1 {
                font-size: 2.6rem;
            }
            .section-title {
                font-size: 1.8rem;
            }
            .slider-container {
                flex-direction: column;
            }
        }

        @media (max-width: 480px) {
            .hero h1 {
                font-size: 2rem;
            }
            .card {
                padding: 20px;
            }
        }

        /* Стилизация скролла */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0d14;
        }
        ::-webkit-scrollbar-thumb {
            background: #f5a623;
            border-radius: 10px;
        }
        #musicBtn{

position:fixed;

right:15px;
top:15px;

width:35px;
height:35px;

border:none;
border-radius:50%;

background:#00eaff;
color:black;

cursor:pointer;

font-size:15px;

z-index:9999;

box-shadow:0 0 15px #00eaff;

transition:.3s;

}


#musicBtn:hover{

transform:scale(1.15);

}
    </style>
    
</head>
<body>

<div class="industrial-bg"></div>

<!-- Навигация -->
<nav class="navbar">
    <div class="logo"><i class="fas fa-microchip"></i> IC2</div>
    <ul class="nav-links" id="navLinks">
        <li><a href="#overview">Обзор</a></li>
        <li><a href="#machines">Машины</a></li>
        <li><a href="#addons">Дополнения</a></li>
        <li><a href="#interactive">Интерактив</a></li>
    </ul>
    <button class="burger" id="burgerBtn">
        <span></span><span></span><span></span>
    </button>
    <audio id="bgMusic" loop>
        <source src="audio1 (1).mp3" type="audio/mpeg">
    </audio>
    <button id="musicBtn">🎵</button>
</nav>

<!-- Герой -->
<section class="hero">
    <div class="badge">⚡ INDUSTRIALCRAFT 2</div>
    <h1>Энергия<br>Прогресса</h1>
    <p class="sub">Мощнейший технический мод для Minecraft. Автоматизация, ядерная энергия, передовые механизмы — всё, чтобы превратить мир в индустриальный рай.</p>
    <div style="margin-top: 32px;">
        <a href="#overview" class="btn-ic"><i class="fas fa-cogs"></i> Исследовать</a>
    </div>
</section>

<!-- Обзор -->
<section id="overview" class="section fade-up">
    <h2 class="section-title">Что такое <span>IndustrialCraft 2</span></h2>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center;">
        <div>
            <p style="font-size: 1.1rem; color: #c8d0e8; margin-bottom: 20px;">
                IndustrialCraft 2 (IC2) — один из старейших и самых известных технических модов для Minecraft. Он добавляет сотни новых механизмов, электрических сетей, сложных рецептов и систему энергетики (EU). Мод вдохновлён реальными промышленными процессами и даёт игроку возможность автоматизировать практически всё.
            </p>
            <ul style="list-style: none; padding: 0;">
                <li style="margin-bottom: 10px;">🔹 <strong style="color: #f5a623;">Энергия EU</strong> — единая система питания для всех машин</li>
                <li style="margin-bottom: 10px;">🔹 <strong style="color: #f5a623;">Добыча ресурсов</strong> — улучшенные инструменты и механизмы для руды</li>
                <li style="margin-bottom: 10px;">🔹 <strong style="color: #f5a623;">Ядерная энергетика</strong> — реакторы с реальными рисками и наградой</li>
                <li style="margin-bottom: 10px;">🔹 <strong style="color: #f5a623;">Улучшение предметов</strong> — нано-броня, квантовая броня, инструменты с зарядкой</li>
            </ul>
        </div>
        <div style="background: #141a2a; border-radius: 28px; padding: 30px; border: 1px solid #2a3048; text-align: center;">
            <i class="fas fa-bolt" style="font-size: 4rem; color: #f5a623;"></i>
            <div style="font-family: 'Orbitron', monospace; font-size: 2rem; color: #f5a623; margin: 10px 0;">EU</div>
            <div style="color: #8a96b8;">32 768 EU/t — пиковая мощность ядерного реактора</div>
        </div>
    </div>
</section>

<!-- Машины -->
<section id="machines" class="section fade-up">
    <h2 class="section-title">Ключевые <span>машины</span></h2>
    <div class="grid">
        <div class="card">
            <i class="fas fa-bolt"></i>
            <h3>Генератор</h3>
            <p>Базовый источник EU. Сжигает уголь, древесину и другое топливо для выработки энергии. Отличное начало для любой фабрики.</p>
            <span class="tag">Базовый</span>
        </div>
        <div class="card">
            <i class="fas fa-compress"></i>
            <h3>Компрессор</h3>
            <p>Сжимает предметы в более плотные формы. Используется для создания углеродных пластин, компрессионных блоков и алмазной пыли.</p>
            <span class="tag">Переработка</span>
        </div>
        <div class="card">
            <i class="fas fa-arrow-trend-up"></i>
            <h3>Макератор</h3>
            <p>Дробит руды в удвоенное количество пыли, повышая выход ресурсов. Незаменим для эффективной добычи.</p>
            <span class="tag">Добыча</span>
        </div>
        <div class="card">
            <i class="fas fa-fire"></i>
            <h3>Печь</h3>
            <p>Электрическая печь, работающая от EU. Плавит руды и предметы в два раза быстрее обычной печи без затрат топлива.</p>
            <span class="tag">Обработка</span>
        </div>
        <div class="card">
            <i class="fas fa-circle-radiation"></i>
            <h3>Ядерный реактор</h3>
            <p>Сердце продвинутой энергетики. Вырабатывает огромное количество EU, но требует управления температурой и защиты от перегрева.</p>
            <span class="tag">Энергия</span>
        </div>
        <div class="card">
            <i class="fas fa-fan"></i>
            <h3>Генератор ветра</h3>
            <p>Возобновляемый источник энергии. Мощность зависит от высоты и погоды. Эффективен в биомах с постоянным ветром.</p>
            <span class="tag">Зелёный</span>
        </div>
    </div>
</section>

<!-- Дополнения -->
<section id="addons" class="section fade-up">
    <h2 class="section-title">Популярные <span>дополнения</span></h2>
    <div class="addon-grid">
        <div class="addon-card">
            <div class="icon"><i class="fas fa-gears"></i></div>
            <h4>GregTech</h4>
            <p>Масштабное дополнение, усложняющее все рецепты и добавляющее сотни новых материалов, машин и многоблочных структур. Сделано для хардкорных инженеров.</p>
            <span class="version">v6.15</span>
        </div>
        <div class="addon-card">
            <div class="icon"><i class="fas fa-sun"></i></div>
            <h4>Advanced Solar Panels</h4>
            <p>Улучшенные солнечные панели для IC2. Дают больше энергии и занимают меньше места. Включает гибридные и молекулярные панели для космической эффективности.</p>
            <span class="version">v3.5</span>
        </div>
        <div class="addon-card">
            <div class="icon"><i class="fas fa-rocket"></i></div>
            <h4>Gravitation Suite</h4>
            <p>Добавляет продвинутую броню: гравитационный костюм с возможностью полёта, улучшенный нано-костюм и квантовую броню с телепортацией.</p>
            <span class="version">v3.1</span>
        </div>
        <div class="addon-card">
            <div class="icon"><i class="fas fa-microchip"></i></div>
            <h4>Nuclear Control</h4>
            <p>Расширяет управление ядерными реакторами: добавляет мониторы, датчики, аварийные выключатели и дистанционное управление для безопасной работы.</p>
            <span class="version">v2.4</span>
        </div>
        <div class="addon-card">
            <div class="icon"><i class="fas fa-tree"></i></div>
            <h4>Forestry</h4>
            <p>Хотя это отдельный мод, он отлично интегрируется с IC2 через био-генераторы и деревообработку. Добавляет пчеловодство и сельское хозяйство.</p>
            <span class="version">v5.8</span>
        </div>
        <div class="addon-card">
            <div class="icon"><i class="fas fa-tools"></i></div>
            <h4>IC2 Classic</h4>
            <p>Альтернативная версия IC2, возвращающая механику классической версии 1.2.5 с упрощёнными рецептами и старым дизайном машин.</p>
            <span class="version">v1.2</span>
        </div>
    </div>
</section>

<!-- Интерактивный блок (JS) -->
<section id="interactive" class="section fade-up">
    <h2 class="section-title">Интерактивный <span>эксперимент</span></h2>
    <div class="slider-section">
        <div class="slider-container">
            <div class="slider-text">
                <h3><i class="fas fa-bolt"></i> Мощность реактора</h3>
                <p>Управляйте энергией ядерного реактора. Чем выше мощность, тем больше EU, но и риск перегрева возрастает. Найдите баланс!</p>
                <div style="margin-top: 16px;">
                    <span id="powerDisplay" style="font-family: 'Orbitron', monospace; font-size: 2rem; color: #f5a623;">50%</span>
                </div>
            </div>
            <div class="slider-control">
                <input type="range" id="powerSlider" min="0" max="100" value="50">
                <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: #6a78a0;">
                    <span>0%</span>
                    <span>Безопасно</span>
                    <span>100%</span>
                </div>
                <div id="powerStatus" style="padding: 12px; border-radius: 16px; background: #1a2038; text-align: center; font-weight: 500; border: 1px solid #2a3048;">
                    ⚡ Стабильный режим
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top: 32px; display: flex; gap: 20px; flex-wrap: wrap; justify-content: center;">
        <button class="btn-ic" id="simulateBtn"><i class="fas fa-play"></i> Симулировать запуск</button>
        <button class="btn-ic" style="background: transparent; border: 1px solid #f5a623; color: #f5a623;" id="resetBtn"><i class="fas fa-undo"></i> Сброс</button>
    </div>
    <div id="simulationLog" style="margin-top: 20px; background: #0f1422; border-radius: 16px; padding: 20px; border: 1px solid #1e2538; font-family: 'Courier New', monospace; font-size: 0.8rem; min-height: 60px; color: #8a96b8;">
        > Система готова. Нажмите «Симулировать запуск».
    </div>
</section>

<!-- Footer -->
<footer>
    <div class="social">
        <a href="#"><i class="fab fa-github"></i></a>
        <a href="#"><i class="fab fa-discord"></i></a>
        <a href="#"><i class="fab fa-youtube"></i></a>
        <a href="#"><i class="fab fa-twitter"></i></a>
    </div>
    <p>IndustrialCraft 2 &amp; дополнения — неофициальный информационный портал</p>
    <p style="margin-top: 6px;">Сделано с ⚡ для сообщества технических игроков</p>
</footer>

<script>

const music = document.getElementById("bgMusic");
const btn = document.getElementById("musicBtn");

let on = false;


btn.onclick = ()=>{

if(on){

music.pause();
btn.innerHTML="🎵";
on=false;

}else{

music.play();
btn.innerHTML="🔇";
on=true;

}

}
    // ===== БУРГЕР-МЕНЮ =====
    document.getElementById('burgerBtn').addEventListener('click', function() {
        document.getElementById('navLinks').classList.toggle('open');
    });

    // ===== СЛАЙДЕР =====
    const slider = document.getElementById('powerSlider');
    const powerDisplay = document.getElementById('powerDisplay');
    const powerStatus = document.getElementById('powerStatus');

    slider.addEventListener('input', function() {
        const val = parseInt(this.value);
        powerDisplay.textContent = val + '%';

        let statusText = '';
        let statusColor = '';
        if (val < 30) {
            statusText = '🟢 Низкая мощность — безопасно';
            statusColor = '#4caf50';
        } else if (val < 60) {
            statusText = '🟡 Стабильный режим — оптимально';
            statusColor = '#f5a623';
        } else if (val < 85) {
            statusText = '🟠 Высокая нагрузка — риск перегрева';
            statusColor = '#ff8c00';
        } else {
            statusText = '🔴 КРИТИЧЕСКИЙ УРОВЕНЬ! Необходимо охлаждение!';
            statusColor = '#e53935';
        }
        powerStatus.textContent = '⚡ ' + statusText;
        powerStatus.style.borderColor = statusColor;
        powerStatus.style.color = statusColor;
    });

    // ===== СИМУЛЯЦИЯ =====
    const log = document.getElementById('simulationLog');
    const simBtn = document.getElementById('simulateBtn');
    const resetBtn = document.getElementById('resetBtn');

    let simulationInterval = null;

    function addLogMessage(msg, type = 'info') {
        const time = new Date().toLocaleTimeString();
        const colors = {
            info: '#8a96b8',
            success: '#4caf50',
            warning: '#f5a623',
            danger: '#e53935'
        };
        const color = colors[type] || '#8a96b8';
        log.innerHTML += `<div style="color: ${color}; border-bottom: 1px solid #1a2038; padding: 4px 0;">[${time}] ${msg}</div>`;
        log.scrollTop = log.scrollHeight;
    }

    function simulateStart() {
        if (simulationInterval) {
            clearInterval(simulationInterval);
            simulationInterval = null;
        }

        const power = parseInt(slider.value);
        addLogMessage(`🚀 Запуск реактора при мощности ${power}%...`, 'info');

        let step = 0;
        const maxSteps = 8;

        simulationInterval = setInterval(() => {
            step++;
            const progress = Math.round((step / maxSteps) * 100);

            if (power > 80 && step > 4) {
                addLogMessage(`⚠️ Температура растёт! ${progress}% — требуется охлаждение`, 'warning');
                if (power > 90 && step > 6) {
                    addLogMessage(`💥 КРИТИЧЕСКИЙ ПЕРЕГРЕВ! Реактор остановлен!`, 'danger');
                    clearInterval(simulationInterval);
                    simulationInterval = null;
                    return;
                }
            }

            if (step === maxSteps) {
                if (power > 80) {
                    addLogMessage(`✅ Реактор запущен, но работает на пределе. Мониторьте температуру!`, 'warning');
                } else {
                    addLogMessage(`✅ Реактор стабильно вырабатывает ${power * 10} EU/t. Система в норме.`, 'success');
                }
                clearInterval(simulationInterval);
                simulationInterval = null;
            }
        }, 500);
    }

    simBtn.addEventListener('click', function() {
        if (simulationInterval) {
            clearInterval(simulationInterval);
            simulationInterval = null;
        }
        addLogMessage('🔄 Начинаем новый цикл симуляции...', 'info');
        setTimeout(simulateStart, 400);
    });

    resetBtn.addEventListener('click', function() {
        if (simulationInterval) {
            clearInterval(simulationInterval);
            simulationInterval = null;
        }
        log.innerHTML = '> Система сброшена. Готов к новому запуску.';
        slider.value = 50;
        powerDisplay.textContent = '50%';
        powerStatus.textContent = '⚡ Стабильный режим — оптимально';
        powerStatus.style.borderColor = '#f5a623';
        powerStatus.style.color = '#f5a623';
        addLogMessage('🔁 Система перезагружена. Нажмите «Симулировать запуск».', 'info');
    });

    // ===== АНИМАЦИЯ ПОЯВЛЕНИЯ =====
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

    // ===== КОНСОЛЬНЫЙ ПРИВЕТ =====
    console.log('⚡ IndustrialCraft 2 — Энциклопедия мода');
    console.log('🔧 Добро пожаловать в мир передовых технологий!');
    console.log('📦 Все данные актуальны для версии IC2 2.8+');
</script>

</body>
</html>
