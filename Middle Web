<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Портфолио | Максим</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ===== ПРЕЛОАДЕР ===== */
        #preloader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #1a1a2e;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.8s ease, visibility 0.8s ease;
        }
        #preloader.hidden {
            opacity: 0;
            visibility: hidden;
        }
        .loader-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(255,255,255,0.1);
            border-top: 4px solid #6c5ce7;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        .loader-text {
            color: white;
            margin-top: 20px;
            font-size: 1.1rem;
            letter-spacing: 2px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* ===== ТЁМНАЯ ТЕМА ===== */
        body.dark-theme {
            --light: #1a1a2e;
            --dark: #f8f9fa;
            --text: #f0f0f0;
            --text-light: #b0b0b0;
            background: #12121e;
        }
        body.dark-theme .section-alt {
            background: #1a1a2e;
        }
        body.dark-theme .card,
        body.dark-theme .work-card,
        body.dark-theme .hobby-card,
        body.dark-theme .mentor-card,
        body.dark-theme .github-card,
        body.dark-theme .tech-card,
        body.dark-theme .achievement-card {
            background: #222244;
        }
        body.dark-theme .step,
        body.dark-theme .progress-point {
            background: #222244;
        }
        body.dark-theme .fact-item {
            background: #222244;
            color: #f0f0f0;
        }
        body.dark-theme .mentor-quote {
            background: #2a2a4a;
        }

        /* ===== КНОПКА ТЕМЫ ===== */
        .theme-toggle {
            position: fixed;
            bottom: 90px;
            right: 25px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(108, 92, 231, 0.4);
            transition: var(--transition);
            z-index: 999;
        }
        .theme-toggle:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 25px rgba(108, 92, 231, 0.6);
        }

        /* ===== КНОПКА "НАВЕРХ" ===== */
        .scroll-top {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(108, 92, 231, 0.4);
            transition: var(--transition);
            opacity: 0;
            visibility: hidden;
            z-index: 999;
        }
        .scroll-top.visible {
            opacity: 1;
            visibility: visible;
        }
        .scroll-top:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 25px rgba(108, 92, 231, 0.6);
        }

        /* ===== 3D-ЭФФЕКТ ДЛЯ КАРТОЧЕК РАБОТ ===== */
        .work-card {
            perspective: 1000px;
            transform-style: preserve-3d;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .work-card:hover {
            transform: rotateY(5deg) rotateX(5deg) scale(1.02);
            box-shadow: 0 15px 40px rgba(108, 92, 231, 0.25);
        }

        /* ===== КРУГОВЫЕ ДИАГРАММЫ ===== */
        .circle-chart {
            position: relative;
            width: 100px;
            height: 100px;
            margin: 0 auto 15px;
        }
        .circle-chart svg {
            transform: rotate(-90deg);
        }
        .circle-chart .bg {
            fill: none;
            stroke: #e0e0e0;
            stroke-width: 8;
        }
        .circle-chart .progress {
            fill: none;
            stroke: var(--primary);
            stroke-width: 8;
            stroke-linecap: round;
            transition: stroke-dasharray 1s ease;
        }
        .circle-chart .label {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text);
        }

        /* ===== ТЕХНОЛОГИИ ===== */
        .tech-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 20px;
        }
        .tech-card {
            background: var(--light);
            padding: 20px 10px;
            border-radius: var(--border-radius);
            text-align: center;
            border: 1px solid #ddd;
            transition: var(--transition);
            cursor: default;
        }
        .tech-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .tech-card i {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 10px;
        }
        .tech-card span {
            display: block;
            font-weight: 600;
            color: var(--text);
        }

        /* ===== ДОСТИЖЕНИЯ ===== */
        .achievement-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 25px;
        }
        .achievement-card {
            background: var(--light);
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            border-left: 4px solid var(--primary);
            transition: var(--transition);
        }
        .achievement-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }
        .achievement-card i {
            font-size: 2rem;
            color: var(--primary);
            margin-bottom: 10px;
        }
        .achievement-card h4 {
            color: var(--dark);
            margin-bottom: 5px;
        }
        .achievement-card p {
            color: var(--text-light);
            font-size: 0.9rem;
        }

        /* ===== ОБЩИЙ СТИЛЬ ===== */
        :root {
            --primary: #6c5ce7;
            --primary-dark: #4834d4;
            --secondary: #fd79a8;
            --dark: #1a1a2e;
            --light: #f8f9fa;
            --text: #2d3436;
            --text-light: #636e72;
            --shadow: 0 4px 20px rgba(0,0,0,0.08);
            --border-radius: 20px;
            --transition: 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', 'Arial', sans-serif;
            background: var(--light);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
            transition: background 0.3s ease, color 0.3s ease;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* ===== НАВИГАЦИЯ ===== */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(26, 26, 46, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            transition: background 0.3s ease;
        }
        body.dark-theme .navbar {
            background: rgba(18, 18, 30, 0.95);
        }

        .navbar .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            font-size: 1.2rem;
            font-weight: 600;
        }

        .logo {
            font-size: 1.5rem;
        }

        .nav-menu {
            display: flex;
            gap: 20px;
            list-style: none;
        }

        .nav-menu a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            font-size: 0.9rem;
            transition: var(--transition);
            padding: 5px 0;
            border-bottom: 2px solid transparent;
        }

        .nav-menu a:hover,
        .nav-menu a.active {
            color: white;
            border-bottom-color: var(--primary);
        }

        .burger {
            display: none;
            flex-direction: column;
            gap: 5px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 5px;
        }

        .burger span {
            width: 25px;
            height: 2px;
            background: white;
            transition: var(--transition);
        }

        .burger.active span:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }
        .burger.active span:nth-child(2) {
            opacity: 0;
        }
        .burger.active span:nth-child(3) {
            transform: rotate(-45deg) translate(5px, -5px);
        }

        /* ===== СЕКЦИИ ===== */
        .section {
            padding: 100px 0 80px;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .section-alt {
            background: white;
            transition: background 0.3s ease;
        }

        .section-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 40px;
            position: relative;
            display: inline-block;
            transition: color 0.3s ease;
        }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 60px;
            height: 4px;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            border-radius: 4px;
        }

        /* ===== 1 БЛОК: О СЕБЕ ===== */
        .about-grid {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 50px;
            align-items: start;
        }

        .about-avatar {
            text-align: center;
        }

        .avatar-placeholder {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            margin: 0 auto 20px;
            box-shadow: 0 10px 30px rgba(108, 92, 231, 0.3);
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .social-links a {
            color: var(--dark);
            font-size: 1.5rem;
            transition: var(--transition);
        }

        .social-links a:hover {
            color: var(--primary);
            transform: translateY(-3px);
        }

        .about-text h3 {
            font-size: 2rem;
            margin-bottom: 15px;
            color: var(--dark);
            transition: color 0.3s ease;
        }

        .about-text p {
            margin-bottom: 10px;
            color: var(--text-light);
            transition: color 0.3s ease;
        }

        .facts-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 20px;
        }

        .fact-item {
            background: var(--light);
            padding: 12px 18px;
            border-radius: 12px;
            border-left: 3px solid var(--primary);
            font-size: 0.95rem;
            transition: background 0.3s ease, color 0.3s ease;
        }

        /* ===== 2 БЛОК: ЦЕЛИ ===== */
        .goal-content {
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .goal-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        .goal-content p {
            font-size: 1.2rem;
            color: var(--text-light);
            line-height: 1.8;
            transition: color 0.3s ease;
        }

        .goal-steps {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin-top: 40px;
        }

        .step {
            background: var(--light);
            padding: 25px;
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

        .step:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow);
        }

        .step-num {
            display: inline-block;
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary);
            opacity: 0.3;
            margin-bottom: 10px;
        }

        .step p {
            font-size: 1rem;
            color: var(--text);
            transition: color 0.3s ease;
        }

        /* ===== 3 БЛОК: ИСТОРИЯ ===== */
        .story-timeline {
            max-width: 700px;
            margin: 0 auto;
        }

        .story-item {
            display: grid;
            grid-template-columns: 100px 1fr;
            gap: 30px;
            padding: 20px 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            position: relative;
        }

        .story-item:last-child {
            border-bottom: none;
        }

        .story-year {
            font-weight: 700;
            font-size: 1.3rem;
            color: var(--primary);
        }

        .story-text h4 {
            font-size: 1.1rem;
            color: var(--dark);
            margin-bottom: 5px;
            transition: color 0.3s ease;
        }

        .story-text p {
            color: var(--text-light);
            transition: color 0.3s ease;
        }

        /* ===== 4 БЛОК: МЕНТОР ===== */
        .mentor-card {
            display: grid;
            grid-template-columns: 100px 1fr;
            gap: 40px;
            background: var(--light);
            padding: 40px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            transition: background 0.3s ease;
        }

        .mentor-avatar {
            font-size: 4rem;
            text-align: center;
        }

        .mentor-info h3 {
            font-size: 1.8rem;
            color: var(--dark);
            margin-bottom: 5px;
            transition: color 0.3s ease;
        }

        .mentor-role {
            color: var(--primary);
            font-weight: 600;
            margin-bottom: 15px;
        }

        .mentor-info p {
            color: var(--text-light);
            line-height: 1.8;
            transition: color 0.3s ease;
        }

        .mentor-quote {
            background: var(--dark);
            color: white;
            padding: 20px;
            border-radius: 12px;
            margin-top: 20px;
            font-style: italic;
            position: relative;
        }

        .mentor-quote::before {
            content: '"';
            font-size: 3rem;
            color: var(--primary);
            position: absolute;
            top: -10px;
            left: 15px;
        }

        /* ===== 5 БЛОК: ПРОГРЕСС ===== */
        .progress-wrapper {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 30px;
            align-items: stretch;
            margin-bottom: 40px;
        }

        .progress-point {
            background: var(--light);
            padding: 30px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            transition: background 0.3s ease;
        }

        .point-label {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 5px;
        }

        .point-date {
            color: var(--text-light);
            font-size: 0.9rem;
            margin-bottom: 15px;
        }

        .point-desc {
            color: var(--text);
            line-height: 1.6;
            transition: color 0.3s ease;
        }

        .point-b {
            border: 2px solid var(--primary);
        }

        .progress-line {
            width: 2px;
            background: linear-gradient(to bottom, var(--primary), var(--secondary));
            position: relative;
        }

        .progress-line::after {
            content: '⬇';
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 1.5rem;
            color: var(--primary);
        }

        .progress-skills {
            max-width: 600px;
            margin: 0 auto;
        }

        .progress-skills h4 {
            text-align: center;
            font-size: 1.2rem;
            color: var(--dark);
            margin-bottom: 20px;
            transition: color 0.3s ease;
        }

        .skill-circle-grid {
            display: flex;
            justify-content: center;
            gap: 40px;
            flex-wrap: wrap;
        }

        .skill-item {
            text-align: center;
        }

        .skill-item span {
            display: block;
            margin-top: 5px;
            font-weight: 500;
        }

        /* ===== 6 БЛОК: ХОББИ ===== */
        .hobbies-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 25px;
        }

        .hobby-card {
            background: var(--light);
            padding: 30px 20px;
            border-radius: var(--border-radius);
            text-align: center;
            transition: var(--transition);
            border: 1px solid transparent;
        }

        .hobby-card:hover {
            border-color: var(--primary);
            transform: translateY(-5px);
            box-shadow: var(--shadow);
        }

        .hobby-icon {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .hobby-card h4 {
            font-size: 1.1rem;
            color: var(--dark);
            margin-bottom: 8px;
            transition: color 0.3s ease;
        }

        .hobby-card p {
            font-size: 0.9rem;
            color: var(--text-light);
            transition: color 0.3s ease;
        }

        /* ===== 7 БЛОК: МОИ РАБОТЫ ===== */
        .works-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .work-card {
            background: var(--light);
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
            cursor: pointer;
        }

        .work-card:hover {
            transform: rotateY(5deg) rotateX(5deg) scale(1.02);
            box-shadow: 0 15px 40px rgba(108, 92, 231, 0.25);
        }

        .work-img {
            height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4rem;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
        }

        .work-info {
            padding: 20px;
        }

        .work-info h4 {
            font-size: 1.2rem;
            color: var(--dark);
            margin-bottom: 8px;
            transition: color 0.3s ease;
        }

        .work-info p {
            color: var(--text-light);
            font-size: 0.95rem;
            margin-bottom: 15px;
            transition: color 0.3s ease;
        }

        .work-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .work-link:hover {
            color: var(--primary-dark);
            gap: 12px;
        }

        /* ===== 8 БЛОК: GITHUB ===== */
        .github-card {
            max-width: 500px;
            margin: 0 auto;
            text-align: center;
            background: var(--light);
            padding: 40px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            transition: background 0.3s ease;
        }

        .github-icon {
            font-size: 4rem;
            color: var(--dark);
            margin-bottom: 15px;
        }

        .github-card h3 {
            font-size: 1.8rem;
            color: var(--dark);
            margin-bottom: 10px;
            transition: color 0.3s ease;
        }

        .github-card p {
            color: var(--text-light);
            margin-bottom: 25px;
            transition: color 0.3s ease;
        }

        .github-btn {
            display: inline-block;
            background: var(--dark);
            color: white;
            padding: 12px 30px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .github-btn:hover {
            background: var(--primary);
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(108, 92, 231, 0.3);
        }

        .github-stats {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 25px;
            padding-top: 25px;
            border-top: 1px solid #e0e0e0;
        }

        .github-stats .stat {
            font-size: 0.9rem;
            color: var(--text-light);
        }

        .github-stats .stat span {
            display: block;
            font-size: 2rem;
            font-weight: 700;
            color: var(--dark);
        }

        /* ===== НОВЫЙ БЛОК: ТЕХНОЛОГИИ ===== */
        .tech-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 20px;
        }
        .tech-card {
            background: var(--light);
            padding: 20px 10px;
            border-radius: var(--border-radius);
            text-align: center;
            border: 1px solid #ddd;
            transition: var(--transition);
            cursor: default;
        }
        .tech-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        .tech-card i {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 10px;
        }
        .tech-card span {
            display: block;
            font-weight: 600;
            color: var(--text);
        }
        .tech-card small {
            display: block;
            color: var(--text-light);
            font-size: 0.7rem;
        }

        /* ===== НОВЫЙ БЛОК: ДОСТИЖЕНИЯ ===== */
        .achievement-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 25px;
        }
        .achievement-card {
            background: var(--light);
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            border-left: 4px solid var(--primary);
            transition: var(--transition);
        }
        .achievement-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }
        .achievement-card i {
            font-size: 2rem;
            color: var(--primary);
            margin-bottom: 10px;
        }
        .achievement-card h4 {
