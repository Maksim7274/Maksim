<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Portal 2 | Aperture Science | Полная энциклопедия</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #1a1a1a;
            font-family: 'Segoe UI', system-ui, -apple-system, 'Roboto', sans-serif;
            color: #e0e0e0;
            line-height: 1.5;
            overflow-x: hidden;
        }

        /* ЗАГРУЗОЧНЫЙ ЭКРАН */
        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000000;
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            gap: 2rem;
            transition: opacity 0.8s ease-out, visibility 0.8s ease-out;
        }
        .loader-logo {
            font-size: 3rem;
            font-weight: 900;
            color: #ff8c00;
            text-shadow: 0 0 15px #ff6600, 0 0 30px #cc5500;
            letter-spacing: 4px;
            font-family: monospace;
            animation: pulseGlow 1.2s infinite alternate;
        }
        @keyframes pulseGlow {
            0% { text-shadow: 0 0 5px #ff8c00; opacity: 0.8; }
            100% { text-shadow: 0 0 25px #ff8c00, 0 0 35px #ff5500; opacity: 1; }
        }
        .loader-progress-container {
            width: 280px;
            background: #2a2a2a;
            border-radius: 60px;
            height: 6px;
            overflow: hidden;
            border: 1px solid #ff8c00;
        }
        .loader-progress-bar {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #ff8c00, #ffcc66);
            border-radius: 60px;
            transition: width 0.1s linear;
        }
        .loader-text {
            color: #ffaa66;
            font-family: monospace;
            font-size: 0.9rem;
            letter-spacing: 2px;
        }

        /* Основной фон */
        .aperture-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #222222 0%, #0d0d0d 100%);
            z-index: -2;
        }
        .aperture-bg::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 100%;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.05"><path fill="none" stroke="%23ffa500" stroke-width="0.5" d="M10 10 L90 10 M10 20 L90 20 M10 30 L90 30 M10 40 L90 40 M10 50 L90 50 M10 60 L90 60 M10 70 L90 70 M10 80 L90 80 M10 90 L90 90 M20 10 L20 90 M30 10 L30 90 M40 10 L40 90 M50 10 L50 90 M60 10 L60 90 M70 10 L70 90 M80 10 L80 90 M90 10 L90 90"/><circle cx="50" cy="50" r="15" fill="none" stroke="%23ffa500" stroke-width="0.8"/></svg>');
            background-repeat: repeat;
            background-size: 40px;
            pointer-events: none;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem 2rem 0 2rem;
        }

        /* Hero */
        .hero {
            min-height: 70vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 2rem 0;
        }
        .hero h1 {
            font-size: 5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #ffa500, #ff6a00);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: -1px;
        }
        .hero-tag {
            font-family: monospace;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid #ff8c00;
            padding: 0.5rem 1.2rem;
            border-radius: 40px;
            font-size: 0.9rem;
            margin: 1.5rem 0 1rem 0;
            backdrop-filter: blur(4px);
        }

        /* Навигация */
        .nav-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem;
            margin: 2rem 0;
        }
        .nav-btn {
            background: rgba(0,0,0,0.5);
            border: 1px solid #ff8c00;
            padding: 0.6rem 1.5rem;
            border-radius: 40px;
            color: #ffaa66;
            cursor: pointer;
            transition: 0.2s;
            font-weight: bold;
        }
        .nav-btn:hover {
            background: #ff8c00;
            color: black;
        }

        .section-title {
            font-size: 2.2rem;
            font-weight: 700;
            border-left: 5px solid #ff8c00;
            padding-left: 1.2rem;
            margin: 3rem 0 2rem 0;
        }

        /* Сетки */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }
        .card {
            background: rgba(30, 30, 35, 0.85);
            backdrop-filter: blur(4px);
            border: 1px solid #ff8c00;
            border-radius: 24px;
            padding: 1.4rem;
            transition: all 0.25s ease;
            cursor: pointer;
        }
        .card:hover {
            transform: translateY(-5px);
            border-color: #ffaa33;
            box-shadow: 0 10px 25px rgba(255, 140, 0, 0.2);
        }
        .char-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1.5rem;
            margin: 1.5rem 0;
        }
        .char-card {
            background: #1f1f1f;
            border-radius: 28px;
            padding: 1rem;
            text-align: center;
            border: 1px solid #ff8c00;
            transition: 0.2s;
            cursor: pointer;
        }
        .char-card i {
            font-size: 3rem;
            color: #ffaa55;
            margin-bottom: 0.5rem;
        }

        .footer {
            text-align: center;
            padding: 2rem;
            font-size: 0.8rem;
            color: #aa8866;
            border-top: 1px solid #ff8c00;
            margin-top: 3rem;
        }

        /* Модальное окно для персонажей */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.95);
            backdrop-filter: blur(8px);
            z-index: 10000;
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background: #1a1a1a;
            border: 2px solid #ff8c00;
            border-radius: 28px;
            max-width: 500px;
            width: 90%;
            padding: 2rem;
            position: relative;
        }
        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 28px;
            cursor: pointer;
            color: #ffaa66;
        }

        @media (max-width: 768px) {
            .container { padding: 1rem; }
            .hero h1 { font-size: 2.8rem; }
        }
    </style>
</head>
<body>

<!-- ЗАГРУЗОЧНЫЙ ЭКРАН -->
<div id="loader" class="loader-overlay">
    <div class="loader-logo">APERTURE SCIENCE</div>
    <div class="loader-progress-container">
        <div class="loader-progress-bar" id="progressBar"></div>
    </div>
    <div class="loader-text" id="loaderText">Инициализация порталов...</div>
</div>

<div class="aperture-bg"></div>
<div class="container" id="mainContent" style="display: none;">
    <div class="hero">
        <div class="hero-tag"><i class="fas fa-flask"></i> APERTURE SCIENCE <i class="fas fa-microchip"></i></div>
        <h1>PORTAL 2</h1>
        <p>Лаборатория по исследованию порталов. Полная энциклопедия — персонажи, мультиплеер, создание игры, предметы и достижения.</p>
    </div>

    <!-- НАВИГАЦИЯ -->
    <div class="nav-links">
        <div class="nav-btn" data-section="characters">Персонажи</div>
        <div class="nav-btn" data-section="coop">Мультиплеер</div>
        <div class="nav-btn" data-section="achievements">Достижения</div>
        <div class="nav-btn" data-section="development">Создание игры</div>
        <div class="nav-btn" data-section="items">Предметы / Технологии</div>
    </div>

    <!-- РАЗДЕЛ: ПЕРСОНАЖИ (все главные) -->
    <div id="characters" class="section-content">
        <h2 class="section-title"><i class="fas fa-robot"></i> Персонажи Portal 2</h2>
        <div class="char-grid" id="charactersGrid"></div>
    </div>

    <!-- РАЗДЕЛ: МУЛЬТИПЛЕЕР -->
    <div id="coop" class="section-content" style="display:none;">
        <h2 class="section-title"><i class="fas fa-users"></i> Кооперативный режим</h2>
        <div class="grid">
            <div class="card"><i class="fas fa-robot"></i> <h3>Атлас и Пи-Боди</h3><p>Два робота, созданных GLaDOS для совместного прохождения тестов. Каждый имеет уникальную раскраску: Атлас (синий), Пи-Боди (оранжевый). Управляются двумя игроками.</p></div>
            <div class="card"><i class="fas fa-puzzle-piece"></i> <h3>Уникальные головоломки</h3><p>Задания требуют синхронных действий: одновременное нажатие кнопок, передача кубов через порталы, взаимное телепортирование.</p></div>
            <div class="card"><i class="fas fa-trophy"></i> <h3>Достижения коопа</h3><p>Специальные ачивки за прохождение всех уровней, завершение без смертей, выполнение особых трюков.</p></div>
            <div class="card"><i class="fas fa-laugh-squint"></i> <h3>Сюжет кооператива</h3><p>GLaDOS использует роботов, чтобы ремонтировать старые тестовые камеры и изучать их поведение. Постепенно открываются новые локации и механики.</p></div>
        </div>
    </div>

    <!-- РАЗДЕЛ: ДОСТИЖЕНИЯ -->
    <div id="achievements" class="section-content" style="display:none;">
        <h2 class="section-title"><i class="fas fa-trophy"></i> Достижения / Ачивки</h2>
        <div class="grid">
            <div class="card"><h3>🏆 Приятное сжигание</h3><p>Уничтожьте куб-компаньона в инсинераторе.</p></div>
            <div class="card"><h3>🎵 Финальный трек</h3><p>Завершите сюжетную кампанию.</p></div>
            <div class="card"><h3>🛠️ Мастер порталов</h3><p>Пройти все кооперативные испытания.</p></div>
            <div class="card"><h3>💥 Прорыв на Луну</h3><p>Сделайте портал на Луну в финальной битве.</p></div>
            <div class="card"><h3>🤖 Дружба роботов</h3><p>Закончить кооперативный режим с напарником.</p></div>
            <div class="card"><h3>📦 Нулевая смерть</h3><p>Пройти уровень, не умирая ни разу.</p></div>
        </div>
    </div>

    <!-- РАЗДЕЛ: СОЗДАНИЕ ИГРЫ -->
    <div id="development" class="section-content" style="display:none;">
        <h2 class="section-title"><i class="fas fa-code"></i> Создание Portal 2</h2>
        <div class="grid">
            <div class="card"><h3>📅 Релиз и разработка</h3><p>Portal 2 вышла в 2011 году на PC, PS3, Xbox 360. Разработка велась компанией Valve более 2,5 лет. Движок — Source.</p></div>
            <div class="card"><h3>✍️ Сценарий</h3><p>Сценаристы: Эрик Волап, Джей Пинкертон, Чет Фалишек. Юмор и диалоги GLaDOS признаны лучшими в истории игр.</p></div>
            <div class="card"><h3>🎭 Озвучка</h3><p>GLaDOS — Эллен Маклейн; Уитли — Стивен Мерчант; Кейв Джонсон — Дж. К. Симмонс; Каролина — Джуди Маклейн.</p></div>
            <div class="card"><h3>🏆 Награды</h3><p>Более 80 наград «Игра года». Высшие оценки от IGN, GameSpot, Metacritic (95/100).</p></div>
        </div>
    </div>

    <!-- РАЗДЕЛ: ПРЕДМЕТЫ / ТЕХНОЛОГИИ -->
    <div id="items" class="section-content" style="display:none;">
        <h2 class="section-title"><i class="fas fa-cogs"></i> Технологии Aperture</h2>
        <div class="grid">
            <div class="card"><h3>🔵🔴 Портал-пушка</h3><p>Создаёт два соединённых портала. Используется для прыжков, перемещения объектов и скорости.</p></div>
            <div class="card"><h3>⚪ Жидкость отталкивания</h3><p>Позволяет прыгать по поверхности и делать длинные прыжки.</p></div>
            <div class="card"><h3>🟠 Жидкость притяжения</h3><p>Ускоряет перемещение и помогает парить над пропастями.</p></div>
            <div class="card"><h3>🧪 Куб-компаньон</h3><p>Одинокий куб, помогает активировать кнопки и давит на весы.</p></div>
            <div class="card"><h3>🔫 Турели</h3><p>Роботы с системой распознавания целей. «Я тебя не вижу…»</p></div>
            <div class="card"><h3>🌀 Портал в космос</h3><p>Физический трюк с порталом на Луну — уникальная механика финала.</p></div>
        </div>
    </div>

    <div class="footer">
        <i class="fas fa-database"></i> APERTURE SCIENCE ARCHIVES | База знаний Portal 2 <br>
        © Valve Corporation | Неофициальный архив
    </div>
</div>

<!-- Модальное окно для деталей персонажей -->
<div id="charModal" class="modal">
    <div class="modal-content">
        <span class="modal-close" onclick="closeModal()">&times;</span>
        <div id="modalBody"></div>
    </div>
</div>

<script>
    // ========== ЗАГРУЗОЧНЫЙ ЭКРАН ==========
    let progress = 0;
    const progressBar = document.getElementById('progressBar');
    const loaderText = document.getElementById('loaderText');
    const loaderOverlay = document.getElementById('loader');
    const mainContent = document.getElementById('mainContent');
    const loadingMessages = ["Загрузка портальной пушки...", "Активация GLaDOS...", "Подготовка тестовых камер...", "Загрузка турелей...", "Почти готово...", "Добро пожаловать в Aperture!"];
    let msgIndex = 0;
    const interval = setInterval(() => {
        progress += Math.random() * 10 + 5;
        if (progress > 100) progress = 100;
        progressBar.style.width = progress + '%';
        if (msgIndex < loadingMessages.length - 1) { loaderText.innerText = loadingMessages[msgIndex]; msgIndex++; }
        else if (progress >= 100) {
            loaderText.innerText = loadingMessages[loadingMessages.length-1];
            clearInterval(interval);
            setTimeout(() => {
                loaderOverlay.style.opacity = '0';
                setTimeout(() => { loaderOverlay.style.display = 'none'; mainContent.style.display = 'block'; }, 800);
            }, 600);
        }
    }, 180);

    // ========== ДАННЫЕ ПЕРСОНАЖЕЙ ==========
    const characters = [
        { name: "GLaDOS", desc: "Генетическая Жизненная Форма. Гениальный ИИ с саркастическим юмором. После событий Portal возвращается к управлению лабораторией.", voice: "Эллен Маклейн" },
        { name: "Челл (Chel)", desc: "Главная героиня. Молчаливая, решительная. Просыпается спустя много лет, проходит испытания и финальную битву с Уитли.", voice: "—" },
        { name: "Уитли (Wheatley)", desc: "Сфера личности, созданная GLaDOS. Помогает Челл сбежать, но предаёт её, подключившись к главному управлению. Озвучка: Стивен Мерчант.", voice: "Стивен Мерчант" },
        { name: "Кейв Джонсон", desc: "Основатель Aperture Science. Безумный гений 1950-х, записи которого разбросаны по старой лаборатории.", voice: "Дж. К. Симмонс" },
        { name: "Каролина", desc: "Ассистентка Кейва, чья личность стала основой для GLaDOS.", voice: "Джуди Маклейн" },
        { name: "Атлас", desc: "Синий робот-компаньон в кооперативном режиме. Часть пары с Пи-Боди.", voice: "звуковые сигналы" },
        { name: "Пи-Боди", desc: "Оранжевый робот-компаньон. Вместе с Атласом решают парные тесты.", voice: "звуковые сигналы" },
        { name: "Турели", desc: "Маленькие роботы с датчиками движения. Стреляют из пулемётов. Их фразы стали мемом.", voice: "Эллен Маклейн" }
    ];

    function renderCharacters() {
        const grid = document.getElementById('charactersGrid');
        if (!grid) return;
        grid.innerHTML = '';
        characters.forEach(ch => {
            const card = document.createElement('div');
            card.className = 'char-card';
            card.onclick = () => showCharacterModal(ch);
            card.innerHTML = `<i class="fas fa-user-robot"></i><h4>${ch.name}</h4><p style="font-size:0.75rem;">${ch.voice.substring(0, 30)}</p>`;
            grid.appendChild(card);
        });
    }

    function showCharacterModal(ch) {
        const modal = document.getElementById('charModal');
        const body = document.getElementById('modalBody');
        body.innerHTML = `
            <h2 style="color:#ffaa55;">${ch.name}</h2>
            <p><strong>Описание:</strong> ${ch.desc}</p>
            <p><strong>Озвучка:</strong> ${ch.voice}</p>
            <div style="margin-top:1rem; border-top:1px solid #ff8c00; padding-top:0.5rem;"><i class="fas fa-microphone-alt"></i> Голос — важная часть атмосферы</div>
        `;
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        document.getElementById('charModal').style.display = 'none';
        document.body.style.overflow = 'auto';
    }
    window.onclick = (e) => { const modal = document.getElementById('charModal'); if (e.target === modal) closeModal(); };

    // НАВИГАЦИЯ МЕЖДУ РАЗДЕЛАМИ
    const sections = ['characters', 'coop', 'achievements', 'development', 'items'];
    const navBtns = document.querySelectorAll('.nav-btn');
    function showSection(sectionId) {
        sections.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.style.display = 'none';
        });
        const activeSection = document.getElementById(sectionId);
        if (activeSection) activeSection.style.display = 'block';
        localStorage.setItem('portal2_last_section', sectionId);
    }
    navBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-section');
            showSection(target);
        });
    });
    const lastSection = localStorage.getItem('portal2_last_section');
    if (lastSection && sections.includes(lastSection)) showSection(lastSection);
    else showSection('characters');

    renderCharacters();
</script>
<!-- Музыка сайта -->
<audio id="bgMusic" loop>
    <source src="Empire_of_Geese_-_Wheatley_Romance_portal_69391771.mp3" type="audio/mpeg">
</audio>

<!-- Кнопка управления -->
<div id="musicControl">
    <button id="musicBtn">🎵 Включить музыку</button>
</div>

<style>
#musicControl{
    position:fixed;
    bottom:20px;
    right:20px;
    z-index:999;
}

#musicBtn{
    background:rgba(20,20,20,0.8);
    color:white;
    border:1px solid #ff4d4d;
    border-radius:50px;
    padding:10px 18px;
    cursor:pointer;
    font-size:14px;
    backdrop-filter:blur(10px);
    transition:0.3s;
}

#musicBtn:hover{
    background:#ff4d4d;
}
</style>

<script>
const music = document.getElementById("bgMusic");
const musicBtn = document.getElementById("musicBtn");

music.volume = 0.35; // громкость от 0 до 1

musicBtn.addEventListener("click", async () => {
    if(music.paused){
        await music.play();
        musicBtn.textContent = "🔇 Выключить музыку";
        localStorage.setItem("fazbear_music","on");
    }else{
        music.pause();
        musicBtn.textContent = "🎵 Включить музыку";
        localStorage.setItem("fazbear_music","off");
    }
});

window.addEventListener("load", () => {
    if(localStorage.getItem("fazbear_music") === "on"){
        music.play().then(()=>{
            musicBtn.textContent = "🔇 Выключить музыку";
        }).catch(()=>{});
    }
});
</script>
</body>
</html>
