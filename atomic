<script>
// ========== ЗАГРУЗКА ==========
setTimeout(() => {
    document.getElementById("boot").style.display = "none";
    document.getElementById("terminal").style.display = "block";
}, 2000);

// ========== ПЕРЕКЛЮЧЕНИЕ ВКЛАДОК ==========
let activeTabId = "gameplay";
let filesAnimationActive = false;
let filesAnimationTimer = null;

function openTab(id) {
    if (activeTabId === "files" && filesAnimationActive) {
        cancelFilesAnimation();
    }
    document.querySelectorAll(".block").forEach(el => el.classList.remove("active"));
    const target = document.getElementById(id);
    target.classList.add("active");
    activeTabId = id;
    if (id === "files") {
        startFilesAnimation();
    }
}

// ========== ПОЛНЫЙ СПИСОК СТРОК ДЛЯ АНИМАЦИИ ==========
// Сначала 5 строк с миганием (каждая висит 5 секунд, потом исчезает)
const initialLines = [
    "ДОСТУП К СЕКРЕТНЫМ ДАННЫМ...",
    "ПРОЕКТ: КОЛЛЕКТИВ",
    "СТАТУС: ОШИБКА",
    "РОБОТЫ: ВНЕ КОНТРОЛЯ",
    "ПРИЧИНА: НЕИЗВЕСТНО"
];
// Заголовок, перед появлением файлов
const headerLine = "ДОПОЛНИТЕЛЬНЫЕ ФАЙЛЫ РАСШИФРОВАНЫ:";
// Список расшифрованных файлов (каждый будет появляться отдельно с задержкой 5 секунд)
const detailedFiles = [
    "«Дневник Петрова»: \"Сеченов планирует установить чипы всем гражданам. Мы не можем этого допустить.\"",
    "«Протокол 734-А»: \"Испытания полимера на людях привели к необратимым изменениям психики. Объекты классифицированы как 'Абстракции'.\"",
    "«Запись переговора O5»: \"Если 'Атомное сердце' будет активировано, человечество потеряет свободу воли.\"",
    "«Схема Близняшек»: \"Созданы из биомассы погибших сотрудников. Эмоциональный интеллект — 98%. Подавлен.\"",
    "«Последнее сообщение ГРУ»: \"Предприятие 3826 зачищено. Рекомендуем ядерную бомбардировку.\"",
    "«Лог испытаний полимера #77»: \"Субъект демонстрирует неконтролируемую регенерацию. Рекомендовано уничтожение.\"",
    "«Аудиосообщение от ХРАЗ»: \"П-3, не верь Сеченову. Он использует тебя. Ищи правду в старых лабораториях.\"",
    "«Схема нейрополимера»: \"При введении вызывает полное подчинение воле оператора. Проект 'Коллектив 2.0' — марионетки.\"",
    "«Приказ № 3826/К»: \"Всем сотрудникам покинуть зону. Активирован протокол 'Чистка'. Уничтожить всё живое.\"",
    "«Запись с камер наблюдения»: \"Объект 'Чёрный сталкер' передвигается по вентиляции. Скорость 80 км/ч. Оружие неэффективно.\""
];

let currentStep = 0;           // общий шаг: сначала initial, потом заголовок, потом detailed
let lineTimeout = null;
let filesContainer = null;

function cancelFilesAnimation() {
    if (lineTimeout) {
        clearTimeout(lineTimeout);
        lineTimeout = null;
    }
    filesAnimationActive = false;
    currentStep = 0;
}

function startFilesAnimation() {
    if (filesAnimationActive) return;
    filesAnimationActive = true;
    currentStep = 0;
    const filesBlock = document.getElementById("files");
    if (!filesBlock) return;
    filesBlock.innerHTML = "";   // очистить блок
    // контейнер, куда будем выводить временные строки
    const displayDiv = document.createElement("div");
    displayDiv.id = "tempLine";
    filesBlock.appendChild(displayDiv);
    // контейнер для постоянных строк (detailed files)
    const permanentContainer = document.createElement("div");
    permanentContainer.id = "permanentFiles";
    filesBlock.appendChild(permanentContainer);
    
    function nextStep() {
        if (!filesAnimationActive) return;
        // Этап 1: показываем initialLines по очереди, каждая 5 секунд
        if (currentStep < initialLines.length) {
            const line = initialLines[currentStep];
            displayDiv.innerHTML = `> ${line}`;
            displayDiv.classList.add("blinking-dots");
            currentStep++;
            lineTimeout = setTimeout(() => {
                // очистить временную строку
                displayDiv.innerHTML = "";
                displayDiv.classList.remove("blinking-dots");
                nextStep();
            }, 5000);
            return;
        }
        // Этап 2: после всех initial, показываем заголовок "ДОПОЛНИТЕЛЬНЫЕ ФАЙЛЫ ..."
        if (currentStep === initialLines.length) {
            displayDiv.innerHTML = `> ${headerLine}`;
            displayDiv.classList.remove("blinking-dots");
            currentStep++;
            lineTimeout = setTimeout(() => {
                displayDiv.innerHTML = "";
                nextStep();
            }, 5000);
            return;
        }
        // Этап 3: по очереди выводим каждый detailed файл в permanentContainer с задержкой 5 секунд
        const detailedIndex = currentStep - (initialLines.length + 1);
        if (detailedIndex < detailedFiles.length) {
            const fileLine = detailedFiles[detailedIndex];
            const newP = document.createElement("p");
            newP.innerHTML = `> ${fileLine}`;
            newP.classList.add("line-appear");
            permanentContainer.appendChild(newP);
            currentStep++;
            lineTimeout = setTimeout(() => {
                nextStep();
            }, 5000);
            return;
        }
        // Конец анимации
        filesAnimationActive = false;
        lineTimeout = null;
    }
    nextStep();
}

// ========== МУЗЫКА ==========
const audio = document.getElementById('bgMusic');
const toggleBtn = document.getElementById('musicToggle');
const statusSpan = document.getElementById('musicStatus');
audio.volume = 0.5;
let isPlaying = false;
toggleBtn.addEventListener('click', () => {
    if (isPlaying) {
        audio.pause();
        statusSpan.innerText = "ВКЛЮЧИТЬ МУЗЫКУ";
    } else {
        audio.play().catch(e => console.log("Автовоспроизведение заблокировано"));
        statusSpan.innerText = "ВЫКЛЮЧИТЬ МУЗЫКУ";
    }
    isPlaying = !isPlaying;
});

// ========== ЭФФЕКТ ПЕЧАТИ ДЛЯ ПЕРВОГО АБЗАЦА В ГЕЙМПЛЕЙ (опционально) ==========
const textElement = document.querySelector("#gameplay p");
if (textElement) {
    let i = 0;
    const original = textElement.innerText;
    textElement.innerText = "";
    function type() {
        if (i < original.length) {
            textElement.innerText += original.charAt(i);
            i++;
            setTimeout(type, 20);
        }
    }
    type();
}
</script>
</body>
</html>
