<script>
    (function(){
        // ----- ВКЛАДКИ -----
        const tabs = document.querySelectorAll('.tab-btn');
        const panes = document.querySelectorAll('.tab-pane');
        function activateTab(tabId) {
            panes.forEach(p => p.classList.remove('active-pane'));
            const target = document.getElementById(tabId);
            if(target) target.classList.add('active-pane');
            tabs.forEach(btn => btn.classList.remove('active'));
            const activeBtn = Array.from(tabs).find(btn => btn.getAttribute('data-tab') === tabId);
            if(activeBtn) activeBtn.classList.add('active');
        }
        tabs.forEach(btn => btn.addEventListener('click', () => activateTab(btn.getAttribute('data-tab'))));

        // ----- МУЗЫКА -----
        const audio = document.getElementById('bgMusic');
        const toggleBtn = document.getElementById('musicToggleBtn');
        const musicSpan = document.getElementById('musicStatusText');
        const volumeSlider = document.getElementById('volumeControl');
        let musicEnabled = false;
        if(audio) audio.volume = parseFloat(volumeSlider.value);
        volumeSlider.addEventListener('input', () => { if(audio) audio.volume = parseFloat(volumeSlider.value); });
        function startMusic() { if(!musicEnabled && audio) { audio.play().then(() => { musicSpan.innerText = "ВЫКЛЮЧИТЬ МУЗЫКУ"; musicEnabled=true; }).catch(()=>{}); } }
        function stopMusic() { if(musicEnabled && audio) { audio.pause(); musicSpan.innerText = "ВКЛЮЧИТЬ МУЗЫКУ"; musicEnabled=false; } }
        toggleBtn.addEventListener('click', (e) => { e.stopPropagation(); if(musicEnabled) stopMusic(); else startMusic(); });
        const autoStart = () => { if(!musicEnabled) startMusic(); document.removeEventListener('click', autoStart); document.removeEventListener('keydown', autoStart); };
        document.addEventListener('click', autoStart);
        document.addEventListener('keydown', autoStart);

        // ----- УНИКАЛЬНЫЕ СООБЩЕНИЯ ДЛЯ КАРТОЧЕК (КАК ТЫ ПРОСИЛ) -----
        const cardMessages = {
            "Фриск": "💛 *Твоё имя — Фриск. Твоя решимость ведёт тебя. Береги её.*",
            "Флауи / Азриэль": "🌼 *«Я слишком много раз умирал внутри. Теперь я просто цветок... но я помню всё.»*",
            "Санс": "🦴 *«хе-хе... ты думаешь, я просто ленивый скелет? Ладно, может, так и есть. Но я знаю, что такое ВРЕМЯ.»*",
            "Папирус": "🦴 *«НЬЕ-ХЕ-ХЕ! Я ВЕЛИКИЙ ПАПИРУС! Мои головоломки не разгадать никому!»*",
            "Андайн": "🐟 *«Я капитан гвардии! И ни один человек не пройдёт мимо меня!... Если ты друг, я могу быть мягче.»*",
            "Альфис": "🐙 *«П-п-привет... Я Альфис. Создатель М-м-меттатона и... экспериментальных ужасов, о которых я не хочу вспоминать.»*",
            "Меттатон": "🤖 *«О, ЛЮДИ! Добро пожаловать на моё ШОУ! ЗВЁЗДЫ не ждут, а МЕТАТТОН готов блистать!»*",
            "Ториэль": "🐐 *«Здравствуй, дитя... Я Ториэль. Пожалуйста, не покидай Руины. Здесь безопаснее.»*",
            "Азгор": "👑 *«Я, король Азгор, хотел лишь свободы для своего народа... Но цена оказалась слишком высока.»*",
            "Гастер": "❓ *[Файл повреждён. Фрагмент ID: 66. Голос из ниоткуда:] „Ты слышишь меня? Уровень FUN активирован.“*",
            "РУИНЫ": "🏚️ *Разрушенный храм. Статуя с заплаканным лицом. Говорят, если дать ей воды, она заплачет сладкими слезами.*",
            "СНОУДЕН": "❄️ *Снежный городок. Если позвонить в дом Санса, иногда можно услышать странный механический звук.*",
            "ГОРЯЧАЯ ЗЕМЛЯ": "🔥 *Лаборатория Альфис. За одним из столов — фотография трёх учёных, но одно лицо стёрто.*",
            "ЯДРО": "🧠 *Энергетический центр. Редкое значение FUN может показать тень, проходящую сквозь стены.*",
            "ЗАМОК АЗГОРА": "🏰 *Тронный зал. В одной из версий игры здесь можно найти пустую комнату с инициалами «W.D.»*",
            "ИСТИННАЯ ЛАБОРАТОРИЯ": "🧪 *Ошибка реальности. Эксперименты по слиянию душ. Альфис умоляла: „Прости меня...“*",
            "ПАЦИФИСТ": "💚 *Финал, где все живы. Даже Флауи. Ты чувствуешь, как слёзы радости текут по щекам.*",
            "НЕЙТРАЛ": "❤️ *Смесь решений. Иногда ты покидаешь Подземелье, оставляя монстров... а иногда остаёшься с ними.*",
            "ГЕНОЦИД": "🩸 *Тьма заполняет экран. Санс ведёт последний разговор: „ты заплатишь за это. возможно, не сегодня, но однажды...“*"
        };
        const cards = document.querySelectorAll('.card');
        cards.forEach(card => {
            card.addEventListener('click', (e) => {
                e.stopPropagation();
                const titleElem = card.querySelector('h3');
                if(titleElem) {
                    let title = titleElem.innerText.trim();
                    let message = cardMessages[title];
                    if(!message) {
                        for(let key in cardMessages) {
                            if(title.includes(key)) { message = cardMessages[key]; break; }
                        }
                    }
                    alert(message || "🔍 *Здесь скрыта тайна. Возможно, ты найдёшь её в другой раз.*");
                }
            });
        });

        // ----- ВСЕ СЕКРЕТЫ (как в оригинале Тоби Фокса) -----
        // 1. Секретный заголовок
        const header = document.getElementById('secretHeader');
        let headerClicks = 0;
        header.addEventListener('click', () => {
            headerClicks++;
            if(headerClicks === 1) console.log("%c[АРХИВ] Вы почувствовали странное присутствие...", "color:#ff9966");
            if(headerClicks === 3) alert("🌌 *Кажется, кто-то наблюдает за тобой из-за пределов кода...*");
            if(headerClicks === 5) {
                alert("💀 Ты нашёл секретную команду. Введи 'determination()' в консоли.");
                console.log("%cПасхалка: determination", "color:red; font-size:12px");
            }
        });

        // 2. Секретный футер (случайная фраза)
        const footer = document.getElementById('secretFooter');
        const footerQuotes = [
            "[ ЛЮБОВЬ ] всё ещё растёт...",
            "Здесь нет ничего, кроме надежды.",
            "Ты чувствуешь, что время идёт вспять.",
            "Вспомни, кто ты.",
            "Пыль... везде пыль.",
            "НОМЕР СТРАНИЦЫ: 66"
        ];
        footer.addEventListener('click', () => {
            const randomQuote = footerQuotes[Math.floor(Math.random() * footerQuotes.length)];
            alert(`🌀 ${randomQuote}`);
        });

        // 3. Клик по секретному тексту во вкладке "Секреты"
        const secretMsg = document.getElementById('secretMessage');
        let msgExpanded = false;
        secretMsg.addEventListener('click', () => {
            if(!msgExpanded) {
                secretMsg.innerHTML = "🔓 <strong>РАСШИФРОВАНО:</strong> G A S T E R  .  W D .  # 6 6  #  <span style='color:#ffaa66'>FUN = 66</span>";
                secretMsg.style.background = "#2a1a0c";
                msgExpanded = true;
            } else {
                secretMsg.innerHTML = "🔎 *Нажми на этот текст...*";
                secretMsg.style.background = "#1f170c";
                msgExpanded = false;
            }
        });

        // 4. Комбинация клавиш MEGALOVANIA
        let keyBuffer = "";
        const secretCode = "megalovania";
        document.addEventListener('keydown', (e) => {
            keyBuffer += e.key.toLowerCase();
            if(keyBuffer.length > secretCode.length) keyBuffer = keyBuffer.slice(-secretCode.length);
            if(keyBuffer === secretCode) {
                alert("⚡ МЕГАЛОВАНИЯ! ⚡\nТы вызвал тайную силу. Санс улыбается.");
