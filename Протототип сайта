<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Clone Drone in the Danger Zone | Кибер-арена</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Segoe UI', 'Roboto', system-ui, sans-serif;
      background: #0a0c10;
      color: #e0e0e0;
      line-height: 1.5;
      overflow-x: hidden;
      scroll-behavior: smooth;
    }
    :root {
      --neon-purple: #c44dff;
      --neon-blue: #4dc9f6;
      --neon-orange: #ff7b42;
      --neon-red: #ff3a4d;
      --dark-bg: #0a0c10;
      --card-bg: #14171f;
      --text-dim: #a0a5b5;
    }
    @keyframes float {
      0%,100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    @keyframes pulse-glow {
      0% { box-shadow: 0 0 5px var(--neon-purple); }
      50% { box-shadow: 0 0 25px var(--neon-purple), 0 0 35px var(--neon-blue); }
      100% { box-shadow: 0 0 5px var(--neon-purple); }
    }
    .fade-up {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s, transform 0.8s;
    }
    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }
    /* Навигация */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 5%;
      background: rgba(10,12,16,0.9);
      backdrop-filter: blur(12px);
      position: fixed;
      width: 100%;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid rgba(196,77,255,0.3);
    }
    .logo {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      background: linear-gradient(135deg, var(--neon-purple), var(--neon-orange));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }
    .nav-links a {
      color: #ccc;
      text-decoration: none;
      font-weight: 500;
      transition: 0.3s;
    }
    .nav-links a:hover {
      color: var(--neon-orange);
      text-shadow: 0 0 12px var(--neon-orange);
    }
    .burger {
      display: none;
      font-size: 1.8rem;
      color: var(--neon-purple);
      cursor: pointer;
      background: none;
      border: none;
    }
    /* Hero с Canvas */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 6rem 1rem 3rem;
      overflow: hidden;
    }
    #hero-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 900px;
    }
    .hero h1 {
      font-size: clamp(2.5rem, 7vw, 5rem);
      font-weight: 900;
      text-transform: uppercase;
      background: linear-gradient(to right, #fff, #ffaa80, var(--neon-blue));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 1rem;
    }
    .hero p {
      font-size: 1.3rem;
      color: #ccc;
      margin-bottom: 2rem;
    }
    .robot-3d {
      width: 200px;
      height: 200px;
      margin: 1rem auto;
      background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="40" r="15" fill="%23c44dff"/><rect x="35" y="55" width="30" height="30" fill="%234dc9f6"/><circle cx="40" cy="45" r="4" fill="white"/><circle cx="60" cy="45" r="4" fill="white"/></svg>') center/contain no-repeat, radial-gradient(circle at center, #2a1a3a, #0a0c10);
      border-radius: 50%;
      box-shadow: 0 0 35px var(--neon-purple);
      animation: float 4s infinite ease-in-out;
      transform-style: preserve-3d;
      transition: transform 0.5s;
    }
    .robot-3d:hover {
      transform: rotateY(15deg) rotateX(10deg) scale(1.05);
    }
    .btn-group {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .btn {
      padding: 0.9rem 2.2rem;
      border-radius: 40px;
      font-weight: bold;
      text-decoration: none;
      font-size: 1.1rem;
      transition: 0.3s;
      border: 2px solid transparent;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }
    .btn-primary {
      background: var(--neon-purple);
      color: #fff;
      border-color: var(--neon-purple);
      box-shadow: 0 0 15px var(--neon-purple);
    }
    .btn-primary:hover {
      background: transparent;
      color: var(--neon-purple);
      box-shadow: 0 0 30px var(--neon-purple);
    }
    .btn-outline {
      border-color: var(--neon-orange);
      color: var(--neon-orange);
      background: transparent;
    }
    .btn-outline:hover {
      background: var(--neon-orange);
      color: #000;
    }
    section {
      padding: 5rem 5%;
      max-width: 1300px;
      margin: 0 auto;
    }
    .section-title {
      font-size: 2.5rem;
      text-align: center;
      margin-bottom: 3rem;
      color: #fff;
      position: relative;
      display: inline-block;
      left: 50%;
      transform: translateX(-50%);
    }
    .section-title::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--neon-purple), var(--neon-orange), var(--neon-blue));
    }
    /* Карточки */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
    }
    .card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 2rem 1.5rem;
      text-align: center;
      border: 1px solid #2a2e3a;
      transition: 0.3s;
      backdrop-filter: blur(5px);
    }
    .card:hover {
      transform: translateY(-8px);
      border-color: var(--neon-purple);
      box-shadow: 0 10px 30px rgba(196,77,255,0.4);
    }
    .card i {
      font-size: 2.5rem;
      color: var(--neon-orange);
      margin-bottom: 1rem;
    }
    .card h3 {
      color: #fff;
      margin-bottom: 0.5rem;
    }
    .upgrade-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1.5rem;
    }
    .upgrade-item {
      background: #1e2130;
      border-radius: 16px;
      padding: 1.5rem 1rem;
      text-align: center;
      border: 1px solid #3a3f50;
      transition: 0.3s;
    }
    .upgrade-item:hover {
      border-color: var(--neon-orange);
      box-shadow: 0 0 20px rgba(255,123,66,0.5);
      transform: scale(1.03);
    }
    .upgrade-item i {
      font-size: 2rem;
      color: var(--neon-blue);
    }
    .arena-card {
      background: linear-gradient(145deg, #1a1e2b, #10131c);
      border-radius: 25px;
      overflow: hidden;
      border: 1px solid #3a3f50;
      transition: 0.3s;
    }
    .arena-card:hover {
      border-color: var(--neon-red);
      box-shadow: 0 0 25px rgba(255,58,77,0.6);
    }
    .arena-img {
      height: 150px;
      background: linear-gradient(45deg, #2a1a3a, #1a2a40);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      color: var(--neon-purple);
    }
    .arena-info {
      padding: 1.5rem;
    }
    /* Звуковая кнопка */
    .sound-toggle {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: var(--neon-purple);
      border: none;
      border-radius: 50%;
      width: 50px;
      height: 50px;
      color: white;
      font-size: 1.5rem;
      cursor: pointer;
      z-index: 999;
      box-shadow: 0 0 20px var(--neon-purple);
    }
    @media (max-width: 768px) {
      .nav-links {
        display: none;
        flex-direction: column;
        width: 100%;
        background: rgba(10,12,16,0.95);
        margin-top: 1rem;
        padding: 1.5rem;
        border-radius: 15px;
      }
      .nav-links.active { display: flex; }
      .burger { display: block; }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="logo"><i class="fas fa-robot"></i> CLONE DRONE</div>
    <button class="burger" id="burger-btn"><i class="fas fa-bars"></i></button>
    <ul class="nav-links" id="nav-menu">
      <li><a href="#hero">Главная</a></li>
      <li><a href="#upgrades">Улучшения</a></li>
      <li><a href="#robots">Роботы</a></li>
      <li><a href="#weapons">Оружие</a></li>
      <li><a href="#arenas">Арены</a></li>
      <li><a href="#story">Сюжет</a></li>
    </ul>
  </nav>

  <!-- Hero с анимированным canvas -->
  <header class="hero" id="hero">
    <canvas id="hero-canvas"></canvas>
    <div class="hero-content">
      <div class="robot-3d"></div>
      <h1>Clone Drone in the Danger Zone</h1>
      <p>Твой разум — оружие. Смерть — лишь перезагрузка. Руби, стреляй, лети.</p>
      <div class="btn-group">
        <a href="#upgrades" class="btn btn-primary"><i class="fas fa-arrow-up"></i> Улучшения</a>
        <a href="#robots" class="btn btn-outline"><i class="fas fa-robot"></i> Энциклопедия</a>
      </div>
    </div>
  </header>

  <!-- Дерево улучшений -->
  <section id="upgrades">
    <h2 class="section-title">⚡ Дерево улучшений</h2>
    <div class="upgrade-grid fade-up">
      <div class="upgrade-item"><i class="fas fa-bolt"></i><h4>Energy</h4><small>Увеличивает запас энергии</small></div>
      <div class="upgrade-item"><i class="fas fa-rocket"></i><h4>Jetpack</h4><small>Позволяет летать</small></div>
      <div class="upgrade-item"><i class="fas fa-fire"></i><h4>Fire Sword</h4><small>Поджигает врагов</small></div>
      <div class="upgrade-item"><i class="fas fa-bow-arrow"></i><h4>Bow</h4><small>Дальнобойный лук</small></div>
      <div class="upgrade-item"><i class="fas fa-spear"></i><h4>Spear</h4><small>Колющее копьё</small></div>
      <div class="upgrade-item"><i class="fas fa-shoe-prints"></i><h4>Kick</h4><small>Мощный пинок</small></div>
      <div class="upgrade-item"><i class="fas fa-shield-haltered"></i><h4>Armor</h4><small>Уменьшает урон</small></div>
      <div class="upgrade-item"><i class="fas fa-heartbeat"></i><h4>Health+</h4><small>Дополнительные жизни</small></div>
    </div>
  </section>

  <!-- Энциклопедия роботов -->
  <section id="robots">
    <h2 class="section-title">🤖 Энциклопедия роботов</h2>
    <div class="grid fade-up">
      <div class="card"><i class="fas fa-circle"></i><h3>Mark 1</h3><p>Базовый дрон с мечом. Твоя первая оболочка.</p></div>
      <div class="card"><i class="fas fa-circle-notch"></i><h3>Mark 2</h3><p>Улучшенный корпус, больше здоровья.</p></div>
      <div class="card"><i class="fas fa-spider"></i><h3>Spider-Tron</h3><p>Паукообразный робот с лазерами.</p></div>
      <div class="card"><i class="fas fa-crown"></i><h3>Captain</h3><p>Лидер арены, мощный ближний бой.</p></div>
      <div class="card"><i class="fas fa-crown" style="color:gold;"></i><h3>Emperor</h3><p>Финальный босс, огромный и смертоносный.</p></div>
      <div class="card"><i class="fas fa-hammer"></i><h3>Hammer Bot</h3><p>Машет гигантским молотом.</p></div>
      <div class="card"><i class="fas fa-fire"></i><h3>Flame Bot</h3><p>Поливает огнём всё вокруг.</p></div>
      <div class="card"><i class="fas fa-bullseye"></i><h3>Archer Bot</h3><p>Стреляет стрелами на расстоянии.</p></div>
      <div class="card"><i class="fas fa-spear"></i><h3>Spear Bot</h3><p>Атакует копьём, держит дистанцию.</p></div>
    </div>
  </section>

  <!-- Энциклопедия оружия -->
  <section id="weapons">
    <h2 class="section-title">⚔️ Энциклопедия оружия</h2>
    <div class="grid fade-up">
      <div class="card"><i class="fas fa-gavel"></i><h3>Лазерный меч</h3><p>Урон 40, скорость атаки высокая. Разрубает врагов на части.</p></div>
      <div class="card"><i class="fas fa-bow-arrow"></i><h3>Лук</h3><p>Урон 25, дальность 15м. Бесшумный.</p></div>
      <div class="card"><i class="fas fa-spear"></i><h3>Копьё</h3><p>Урон 35, дальность 3м. Пронзает броню.</p></div>
      <div class="card"><i class="fas fa-fire-alt"></i><h3>Огнемёт</h3><p>Урон 20/сек, область поражения. Поджигает.</p></div>
      <div class="card"><i class="fas fa-hammer"></i><h3>Молот</h3><p>Урон 60, медленный. Отбрасывает врагов.</p></div>
      <div class="card"><i class="fas fa-hand-rock"></i><h3>Кулаки/Пинок</h3><p>Урон 15, быстрое добивание.</p></div>
    </div>
  </section>

  <!-- Арены -->
  <section id="arenas">
    <h2 class="section-title">🏟️ Арены сражений</h2>
    <div class="grid fade-up">
      <div class="arena-card">
        <div class="arena-img"><i class="fas fa-square"></i></div>
        <div class="arena-info"><h3>Классическая арена</h3><p>Прямоугольное поле с шипами.</p></div>
      </div>
      <div class="arena-card">
        <div class="arena-img"><i class="fas fa-circle"></i></div>
        <div class="arena-info"><h3>Круглая яма</h3><p>Без стен, легко упасть.</p></div>
      </div>
      <div class="arena-card">
        <div class="arena-img"><i class="fas fa-mountain"></i></div>
        <div class="arena-info"><h3>Лавовая арена</h3><p>Островки посреди лавы.</p></div>
      </div>
    </div>
  </section>

  <!-- Сюжет и персонажи -->
  <section id="story">
    <h2 class="section-title">📖 Сюжет и персонажи</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: center;">
      <div style="flex:1 1 300px;">
        <p style="font-size:1.2rem;">В далёком будущем роботы сражаются на арене ради развлечения Императора. Ты — клон, чьё сознание перезагружается после каждой смерти. Тебе помогают загадочный <strong style="color:var(--neon-orange);">Комментатор</strong> и <strong style="color:var(--neon-blue);">Analysis Bot</strong>, раскрывая тайны арены. Твоя цель — победить Капитана и самого Императора, чтобы обрести свободу.</p>
      </div>
      <div class="card" style="flex:0 0 250px;">
        <i class="fas fa-microphone"></i>
        <h3>Commentator</h3>
        <p>Ведёт шоу, комментирует каждый твой шаг.</p>
      </div>
    </div>
  </section>

  <footer style="background:#050608; text-align:center; padding:2rem; border-top:1px solid #2a2a3a; color:#888; margin-top:3rem;">
    <p>© 2026 Фанатский сайт Clone Drone in the Danger Zone. Doborog Games.</p>
    <div style="margin:1rem 0; display:flex; justify-content:center; gap:2rem; font-size:1.8rem;">
      <a href="#" style="color:#aaa;"><i class="fab fa-steam"></i></a>
      <a href="#" style="color:#aaa;"><i class="fab fa-discord"></i></a>
    </div>
  </footer>

  <!-- Кнопка включения звука -->
  <button class="sound-toggle" id="sound-btn" title="Вкл/Выкл звуки наведения">🔊</button>

  <script>
    (function() {
      // Canvas анимация
      const canvas = document.getElementById('hero-canvas');
      const ctx = canvas.getContext('2d');
      let width, height;
      let particles = [];
      let lasers = [];

      function resizeCanvas() {
        width = canvas.width = canvas.offsetWidth;
        height = canvas.height = canvas.offsetHeight;
      }
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();

      class Particle {
        constructor() {
          this.reset();
        }
        reset() {
          this.x = Math.random() * width;
          this.y = Math.random() * height;
          this.vx = (Math.random() - 0.5) * 2;
          this.vy = (Math.random() - 0.5) * 2;
          this.size = Math.random() * 3 + 1;
          this.alpha = Math.random() * 0.7 + 0.3;
          this.color = `rgba(196,77,255,${this.alpha})`;
        }
        update() {
          this.x += this.vx;
          this.y += this.vy;
          if (this.x < 0 || this.x > width || this.y < 0 || this.y > height) this.reset();
        }
        draw() {
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          ctx.fillStyle = this.color;
          ctx.fill();
        }
      }

      class Laser {
        constructor() {
          this.reset();
        }
        reset() {
          this.x1 = Math.random() * width;
          this.y1 = Math.random() * height;
          this.x2 = Math.random() * width;
          this.y2 = Math.random() * height;
          this.life = 1;
          this.decay = 0.005 + Math.random() * 0.01;
          this.color = `rgba(255,123,66,${this.life})`;
        }
        update() {
          this.life -= this.decay;
          if (this.life <= 0) this.reset();
        }
        draw() {
          ctx.beginPath();
          ctx.moveTo(this.x1, this.y1);
          ctx.lineTo(this.x2, this.y2);
          ctx.strokeStyle = `rgba(255,123,66,${this.life})`;
          ctx.lineWidth = 1.5;
          ctx.shadowColor = '#ff7b42';
          ctx.shadowBlur = 10;
          ctx.stroke();
          ctx.shadowBlur = 0;
        }
      }

      for (let i = 0; i < 80; i++) particles.push(new Particle());
      for (let i = 0; i < 12; i++) lasers.push(new Laser());

      function animate() {
        ctx.clearRect(0, 0, width, height);
        particles.forEach(p => { p.update(); p.draw(); });
        lasers.forEach(l => { l.update(); l.draw(); });
        requestAnimationFrame(animate);
      }
      animate();

      // Мобильное меню
      const burger = document.getElementById('burger-btn');
      const navMenu = document.getElementById('nav-menu');
      burger.addEventListener('click', () => navMenu.classList.toggle('active'));
      document.querySelectorAll('.nav-links a').forEach(link => {
        link.addEventListener('click', () => navMenu.classList.remove('active'));
      });

      // Плавный скролл
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          const href = this.getAttribute('href');
          if (href === "#") return;
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      // Анимация появления
      const fadeElements = document.querySelectorAll('.fade-up');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      }, { threshold: 0.2 });
      fadeElements.forEach(el => observer.observe(el));
      window.addEventListener('load', () => {
        fadeElements.forEach(el => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight - 100) el.classList.add('visible');
        });
      });

      // Звуковые эффекты при наведении (Web Audio API)
      let soundEnabled = true;
      const soundBtn = document.getElementById('sound-btn');
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      let audioCtx;
      function playHoverSound() {
        if (!soundEnabled) return;
        if (!audioCtx) audioCtx = new AudioContext();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(800, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.1);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.1);
      }
      document.querySelectorAll('.btn, .card, .upgrade-item, .arena-card, .nav-links a').forEach(el => {
        el.addEventListener('mouseenter', playHoverSound);
      });
      soundBtn.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        soundBtn.textContent = soundEnabled ? '🔊' : '🔇';
      });
    })();
  </script>
</body>
</html>
