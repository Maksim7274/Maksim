<script>
const music = document.getElementById("bgMusic");
const musicBtn = document.getElementById("musicBtn");

music.volume = 0.35; // громкость от 0 до 1

musicBtn.addEventListener("click", async () => {
    if(music.paused){
        await music.play();
        musicBtn.textContent = "🔇 Выключить музыку";
        localStorage.setItem("fazbear_music","on");
    }else{
        music.pause();
        musicBtn.textContent = "🎵 Включить музыку";
        localStorage.setItem("fazbear_music","off");
    }
});

window.addEventListener("load", () => {
    if(localStorage.getItem("fazbear_music") === "on"){
        music.play().then(()=>{
            musicBtn.textContent = "🔇 Выключить музыку";
        }).catch(()=>{});
    }
});
</script>
