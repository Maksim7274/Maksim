<script>
    // ========== ЗАГРУЗОЧНЫЙ ЭКРАН (имитация загрузки) ==========
    let progress = 0;
    const progressBar = document.getElementById('progressBar');
    const loaderText = document.getElementById('loaderText');
    const loaderOverlay = document.getElementById('loader');
    const mainContent = document.getElementById('mainContent');

    const loadingMessages = [
        "Инициализация охоты...",
        "Активация аниматроников...",
        "Загрузка подарков...",
        "Подготовка карт...",
        "Страх нарастает...",
        "Почти готово...",
        "Добро пожаловать в Fazbear Hunt!"
    ];
    
    let msgIndex = 0;
    const interval = setInterval(() => {
        progress += Math.random() * 10 + 5;
        if (progress > 100) progress = 100;
        progressBar.style.width = progress + '%';
        
        if (msgIndex < loadingMessages.length - 1) {
            loaderText.innerText = loadingMessages[msgIndex];
            msgIndex++;
        } else if (progress >= 100) {
            loaderText.innerText = loadingMessages[loadingMessages.length - 1];
            clearInterval(interval);
            setTimeout(() => {
                loaderOverlay.style.opacity = '0';
                setTimeout(() => {
                    loaderOverlay.style.display = 'none';
                    mainContent.style.display = 'block';
                    // Запускаем анимации появления
                    const fades = document.querySelectorAll('.fade-up');
                    fades.forEach(el => {
                        if (el.getBoundingClientRect().top < window.innerHeight - 100) {
                            el.classList.add('visible');
                        }
                    });
                }, 800);
            }, 600);
        }
    }, 180);
    
    // ========== ОСНОВНЫЕ СКРИПТЫ ==========
    const fadeElements = document.querySelectorAll('.fade-up');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: "0px 0px -30px 0px" });
    
    // Отложенный запуск observer (после загрузки контента)
    setTimeout(() => {
        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    }, 1000);
    
    const themeBtns = document.querySelectorAll('.theme-btn');
    function setTheme(themeName) {
        document.body.classList.remove('light', 'hacker', 'tech');
        if (themeName !== 'default') {
            document.body.classList.add(themeName);
        }
        localStorage.setItem('fazbear_theme', themeName);
    }
    themeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const theme = btn.getAttribute('data-theme');
            setTheme(theme);
        });
    });
    const savedTheme = localStorage.getItem('fazbear_theme');
    if (savedTheme && savedTheme !== 'default') setTheme(savedTheme);
    else if (!savedTheme) setTheme('default');
    
    function getProgressiveDate() {
        const startDate = new Date(2025, 10, 10);
        const today = new Date();
        const diffDays = Math.floor((today - startDate) / (1000 * 60 * 60 * 24));
        let progressiveDate = new Date(startDate);
        if (diffDays > 0) progressiveDate.setDate(startDate.getDate() + diffDays);
        else progressiveDate = startDate;
        const months = ["января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря"];
        const day = progressiveDate.getDate();
        const month = months[progressiveDate.getMonth()];
        const year = progressiveDate.getFullYear();
        return { day, month, year };
    }
    
    function updateDynamicDates() {
        const { day, month, year } = getProgressiveDate();
        const dateStr = `${day} ${month} ${year}`;
        const dynamicSpan = document.getElementById('dynamicDateDisplay');
        const footerSpan = document.getElementById('footerDateSpan');
        if (dynamicSpan) dynamicSpan.innerHTML = `📅 ${dateStr} (динамический архив)`;
        if (footerSpan) footerSpan.innerText = dateStr;
    }
    updateDynamicDates();
    setInterval(updateDynamicDates, 60000);
</script>
